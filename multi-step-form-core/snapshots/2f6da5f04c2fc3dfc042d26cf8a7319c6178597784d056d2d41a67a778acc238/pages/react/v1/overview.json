ss. Native HTML or your design system can render the same\nfields. Supply labels, input types, and error feedback in the rendered controls."]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"installation.md"},"children":["Install packages"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"quick-start.md"},"children":["Build a complete form"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../../core/v1/guides/updates-and-helpers.md"},"children":["Update values and write helpers"]}]},"\n"]]}],"toc":[{"title":"Follow an answer through the form","url":"#follow-an-answer-through-the-form","depth":2},{"title":"Learn the vocabulary","url":"#learn-the-vocabulary","depth":2},{"title":"Choose a learning path","url":"#choose-a-learning-path","depth":2},{"title":"Keep application decisions explicit","url":"#keep-application-decisions-explicit","depth":2},{"title":"Next steps","url":"#next-steps","depth":2}]}