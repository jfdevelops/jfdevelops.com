{
  "name": "jfdevelops.com",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.1",
  "portless": "jfdevelops",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "portless run node scripts/dev.mjs",
    "dev:direct": "node scripts/dev.mjs",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:dashboard": "convex dashboard",
    "auth:generate": "npx @better-auth/cli generate --config ./convex/betterAuth/auth.ts --output ./convex/betterAuth/schema.ts",
    "clean": "powershell -ExecutionPolicy Bypass -File scripts/clean.ps1",
    "setup:defender": "powershell -ExecutionPolicy Bypass -File scripts/fix-defender.ps1",
    "reinstall": "pnpm run clean && pnpm install",
    "update:jfd": "pnpm run clean && pnpm update \"@jfdevelops/*\" --latest && pnpm install"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@cloudflare/vite-plugin": "^1.40.1",
    "@convex-dev/react-query": "^0.1.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@getbrevo/brevo": "^6.0.2",
    "@hugeicons/core-free-icons": "^4.2.0",
    "@hugeicons/react": "^1.1.6",
    "@jfdevelops/react-layout": "^0.6.0",
    "@jfdevelops/react-layout-composables": "^0.2.3",
    "@jfdevelops/react-layout-validator": "^0.2.3",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.168.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.42.3",
    "lucide-react": "^0.545.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-email": "6.9.0",
    "shadcn": "^4.11.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.167.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^28.1.0",
    "portless": "^0.15.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wrangler": "^4.99.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss"
    ]
  }
}
