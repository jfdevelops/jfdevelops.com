{
  "name": "jfdevelops.com",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "portless": "jfdevelops",
  "scripts": {
    "dev": "portless run node scripts/dev.mjs",
    "dev:direct": "node scripts/dev.mjs",
    "build": "vite build",
    "serve": "vite preview",
    "test": "vitest run --passWithNoTests",
    "test:ui": "vitest --ui",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "deploy": "pnpm build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "convex:dev": "convex dev",
    "convex:deploy": "convex deploy",
    "convex:dashboard": "convex dashboard",
    "auth:generate": "npx @better-auth/cli generate --config ./convex/betterAuth/auth.ts --output ./convex/betterAuth/schema.ts",
    "clean": "powershell -ExecutionPolicy Bypass -File scripts/clean.ps1",
    "setup:defender": "powershell -ExecutionPolicy Bypass -File scripts/fix-defender.ps1",
    "reinstall": "pnpm run clean && pnpm install",
    "update:jfd": "pnpm run clean && pnpm update \"@jfdevelops/*\" --latest && pnpm install",
    "typecheck": "tsc --noEmit --incremental false",
    "docs:generate": "node scripts/generate-docs.mjs",
    "docs:publish": "tsx scripts/publish-docs.ts",
    "docs:seed": "pnpm docs:generate && pnpm docs:publish",
    "docs:verify": "tsx scripts/verify-docs-artifact.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@cloudflare/vite-plugin": "^1.70.0",
    "@convex-dev/react-query": "^0.1.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@getbrevo/brevo": "^6.2.0",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@jfdevelops/react-layout": "^4.1.0",
    "@jfdevelops/react-layout-adapter-zod": "^1.0.0",
    "@jfdevelops/react-layout-composables": "^1.2.1",
    "@jfdevelops/react-layout-validator": "^1.2.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "latest",
    "@tanstack/react-query": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-router-ssr-query": "latest",
    "@tanstack/react-start": "latest",
    "@tanstack/router-plugin": "^1.169.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.51.0",
    "lucide-react": "^1.75.0",
    "markdown-it": "^15.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "6.11.16",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@jfdevelops/cli": "0.8.0",
    "@jfdevelops/skills": "0.1.1",
    "@shikijs/twoslash": "^4.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.168.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/ui": "^5.1.1",
    "jsdom": "^31.0.1",
    "portless": "^0.18.1",
    "shiki": "^4.6.0",
    "tsx": "^4.23.15",
    "twoslash": "^0.3.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.164.0"
  },
  "engines": {
    "node": "^26.13.1"
  }
}
