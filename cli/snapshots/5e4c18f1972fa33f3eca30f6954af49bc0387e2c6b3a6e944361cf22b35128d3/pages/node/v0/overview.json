{"schemaVersion":1,"framework":"node","version":"v0","id":"overview","title":"Overview","description":"Set up projects and maintain package-owned agent skills with the jfdevelops CLI.","body":[{"tag":"p","props":{},"children":["The jfdevelops CLI creates TypeScript projects and brings shared conventions and dependency-owned agent skills into existing repositories. Use it when your team needs consistent project setup and instructions that track installed packages."]},"\n",{"tag":"mdx:h2","props":{"id":"choose-a-workflow"},"children":["Choose a workflow"]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Goal"]},{"tag":"th","props":{},"children":["Command"]},{"tag":"th","props":{},"children":["Read next"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Start an app or library"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["jfdevelops create my-project"]}]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"getting-started.md"},"children":["Getting started"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Adopt an existing repository"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["jfdevelops init"]}]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"getting-started.md#adopt-an-existing-project"},"children":["Getting started"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Add tooling or a workspace package"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["jfdevelops add"]}]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"commands.md#add"},"children":["Command reference"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Check installed skill copies"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["jfdevelops skills --check"]}]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"skills.md"},"children":["Skills and conflicts"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Refresh the CLI and setup"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["jfdevelops update"]}]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"commands.md#jfdevelops-update-directory"},"children":["Command reference"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Publish skills with a library"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["jfdevelops create skills"]}]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"authoring.md"},"children":["Authoring skills"]}]}]]}]]}]]},"\n",{"tag":"mdx:h2","props":{"id":"review-changes"},"children":["Review changes"]},"\n",{"tag":"p","props":{},"children":[["Interactive commands show planned file changes and ask how to handle conflicts.\nThe CLI records file hashes in ",{"tag":"code","props":{},"children":["jfdevelops.json"]}," so later runs can distinguish its\ngenerated content from local edits. ",{"tag":"code","props":{},"children":["create"]}," and ",{"tag":"code","props":{},"children":["init"]}," support unattended execution\nwith ",{"tag":"code","props":{},"children":["--yes"]},"; other mutating commands require a terminal."]]},"\n",{"tag":"p","props":{},"children":[["Package installation is a separate step in some workflows. Cancelling a later\nreview retains completed installs and earlier applied changes. Review the\n",{"tag":"mdx:a","props":{"href":"commands.md"},"children":["command reference"]}," before automating setup or updates."]]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"installation.md"},"children":["Install the CLI"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"getting-started.md"},"children":["Create or adopt a project"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"configuration.md"},"children":["Understand configuration and ownership"]},"."]]},"\n"]]}],"toc":[{"title":"Choose a workflow","url":"#choose-a-workflow","depth":2},{"title":"Review changes","url":"#review-changes","depth":2},{"title":"Next steps","url":"#next-steps","depth":2}]}