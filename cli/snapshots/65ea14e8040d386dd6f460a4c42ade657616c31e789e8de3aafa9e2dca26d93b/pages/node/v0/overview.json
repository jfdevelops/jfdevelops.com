{"schemaVersion":1,"framework":"node","version":"v0","id":"overview","title":"Overview","description":"Set up projects and keep their shared and package-owned agent skills current with the jfdevelops CLI.","body":[{"tag":"p","props":{},"children":[["The jfdevelops CLI creates TypeScript projects, adopts existing repositories, and installs two kinds of agent skills: shared jfdevelops conventions fetched from the ",{"tag":"code","props":{},"children":["jfdevelops/skills"]}," repository, and skills your installed packages publish. Use it when your team needs consistent project setup and instructions that track installed packages."]]},"\n",{"tag":"mdx:h2","props":{"id":"choose-a-workflow"},"children":["Choose a workflow"]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Goal"]},{"tag":"th","props":{},"children":["Command"]},{"tag":"th","props":{},"children":["Read next"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Start an app or library"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["npx @jfdevelops/cli create my-project"]}]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"getting-started.md"},"children":["Getting started"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Adopt an existing repository"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["npx @jfdevelops/cli init"]}]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"getting-started.md#adopt-an-existing-project"},"children":["Getting started"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Add an integration such as Convex or docs"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["jfdevelops add addon <name>"]}]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"addons.md"},"children":["Addons"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Enable a skill or add a workspace package"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["jfdevelops add"]}]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"commands.md#add"},"children":["Command reference"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Check installed skill copies"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["jfdevelops skills --check"]}]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"skills.md#check-skill-status"},"children":["Skills and conflicts"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Compare skills with upstream"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["jfdevelops skills outdated"]}]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"skills.md#compare-with-upstream-main"},"children":["Skills and conflicts"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Refresh the CLI and setup"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["jfdevelops update"]}]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"commands.md#update-directory"},"children":["Command reference"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Publish skills with a library"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["jfdevelops create skills"]}]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"authoring.md"},"children":["Authoring skills"]}]}]]}]]}]]},"\n",{"tag":"mdx:h2","props":{"id":"how-it-works"},"children":["How it works"]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Term"]},{"tag":"th","props":{},"children":["Meaning"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[["Project and ",{"tag":"code","props":{},"children":["jfdevelops.json"]}]]},{"tag":"td","props":{},"children":[["The project root and the file where the CLI records its setup; see ",{"tag":"mdx:a","props":{"href":"configuration.md"},"children":["Configuration"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Target"]},{"tag":"td","props":{},"children":["An app or library the CLI tracks: each workspace package, or the project itself"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Shared convention skills"]},{"tag":"td","props":{},"children":[["Skills from the ",{"tag":"code","props":{},"children":["jfdevelops/skills"]}," repository on ",{"tag":"code","props":{},"children":["main"]},", installed in every project"]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Package skills"]},{"tag":"td","props":{},"children":[["Skills that a dependency declares in its ",{"tag":"code","props":{},"children":["package.json"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Addon"]},{"tag":"td","props":{},"children":[["An integration such as Convex, Portless, or docs that gates its package's skills; see ",{"tag":"mdx:a","props":{"href":"addons.md"},"children":["Addons"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Coding agents"]},{"tag":"td","props":{},"children":[["Claude Code, Codex, Cursor, and GitHub Copilot, which load the skills in ",{"tag":"code","props":{},"children":[".agents/skills"]}," and ",{"tag":"code","props":{},"children":[".claude/skills"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Managed files"]},{"tag":"td","props":{},"children":[["Files the CLI owns, recorded with a hash; see ",{"tag":"mdx:a","props":{"href":"skills.md#how-the-cli-tells-your-edits-from-its-own-files"},"children":["Skills"]}]]}]]}]]}]]},"\n",{"tag":"mdx:h2","props":{"id":"review-changes"},"children":["Review changes"]},"\n",{"tag":"p","props":{},"children":[["Every change is previewed as a file tree, and the CLI asks how to handle each conflict (see ",{"tag":"mdx:a","props":{"href":"skills.md#conflicts"},"children":["Conflicts"]},").\nThe CLI records file hashes in ",{"tag":"code","props":{},"children":["jfdevelops.json"]}," so later runs can distinguish its\ngenerated content from local edits. ",{"tag":"code","props":{},"children":["create"]}," and ",{"tag":"code","props":{},"children":["init"]}," support unattended execution\nwith ",{"tag":"code","props":{},"children":["--yes"]},"; other mutating commands require a terminal. ",{"tag":"code","props":{},"children":["skills"]},", ",{"tag":"code","props":{},"children":["skills outdated"]},", and ",{"tag":"code","props":{},"children":["add --list"]}," are read-only and need no terminal."]]},"\n",{"tag":"p","props":{},"children":[["Most commands need Git and network access; see ",{"tag":"mdx:a","props":{"href":"commands.md#command-requirements"},"children":["command requirements"]},"."]]},"\n",{"tag":"p","props":{},"children":[["Package installation is a separate step in some workflows. Cancelling a later\nreview retains completed installs and earlier applied changes. Review the\n",{"tag":"mdx:a","props":{"href":"commands.md"},"children":["command reference"]}," before automating setup or updates."]]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"installation.md"},"children":["Install the CLI"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"getting-started.md"},"children":["Create or adopt a project"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"skills.md"},"children":["Manage skills and conflicts"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"addons.md"},"children":["Adopt addons"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"configuration.md"},"children":["Understand configuration and ownership"]},"."]]},"\n"]]}],"toc":[{"title":"Choose a workflow","url":"#choose-a-workflow","depth":2},{"title":"How it works","url":"#how-it-works","depth":2},{"title":"Review changes","url":"#review-changes","depth":2},{"title":"Next steps","url":"#next-steps","depth":2}]}