ght":"#6F42C1","--shiki-dark":"#B392F0"}},"children":["bun"]},{"tag":"span","props":{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"}},"children":[" add"]},{"tag":"span","props":{"style":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"}},"children":[" -D"]},{"tag":"span","props":{"style":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"}},"children":[" --exact"]},{"tag":"span","props":{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"}},"children":[" @jfdevelops/cli"]}]]}]}]}]}]]},"\n"]]},"\n",{"tag":"li","props":{},"children":[["\n",{"tag":"p","props":{},"children":[["Run ",{"tag":"code","props":{},"children":["jfdevelops skills sync"]},"."]]},"\n"]]},"\n",{"tag":"li","props":{},"children":[["\n",{"tag":"p","props":{},"children":[["Make sure every collaborator and CI job runs the upgraded CLI. Releases 0.7.0 through 0.9.0 read shared skills from the installed ",{"tag":"code","props":{},"children":["@jfdevelops/skills"]}," package, so a sync with an older CLI rewrites them from npm."]]},"\n"]]},"\n"]]},"\n",{"tag":"p","props":{},"children":[["Keep the ",{"tag":"code","props":{},"children":["@jfdevelops/skills"]}," development dependency. If you removed it, as the 0.10.0 docs suggested, running ",{"tag":"code","props":{},"children":["jfdevelops init"]}," or ",{"tag":"code","props":{},"children":["jfdevelops update"]}," with a later release adds it back."]]},"\n",{"tag":"mdx:h2","props":{"id":"how-the-cli-tells-your-edits-from-its-own-files"},"children":["How the CLI tells your edits from its own files"]},"\n",{"tag":"p","props":{},"children":[[{"tag":"code","props":{},"children":["jfdevelops.json"]}," records the SHA-256 of every file the CLI wrote. Every command that writes files compares each file on disk with that record before changing it:"]]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":["If it is unchanged, the CLI may update or delete it."]},"\n",{"tag":"li","props":{},"children":["If it differs, it is yours now: the CLI shows a diff and asks."]},"\n",{"tag":"li","props":{},"children":["If a file was edited after the plan was shown but before it was applied, that file is skipped and reported as failed instead of being overwritten."]},"\n"]]},"\n",{"tag":"mdx:h2","props":{"id":"read-a-planned-change"},"children":["Read a planned change"]},"\n",{"tag":"p","props":{},"children":["Before applying, the CLI shows a tree of every planned path with an action:"]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Action"]},{"tag":"th","props":{},"children":["Meaning"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["create"]}]},{"tag":"td","props":{},"children":["A new file"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["update"]}]},{"tag":"td","props":{},"children":["An unchanged managed file is replaced"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["edit"]}]},{"tag":"td","props":{},"children":[["A targeted edit of a file you own, such as the ",{"tag":"code","props":{},"children":["AGENTS.md"]}," block or ",{"tag":"code","props":{},"children":["package.json"]}," scripts"]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["adopt"]}]},{"tag":"td","props":{},"children":["An existing identical file is now recorded as managed"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["delete"]}]},{"tag":"td","props":{},"children":["An unchanged managed file is no longer needed"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["forget"]}]},{"tag":"td","props":{},"children":["The record of a file that is already gone is dropped"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["conflict"]}]},{"tag":"td","props":{},"children":["The file needs your decision"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["write"]}]},{"tag":"td","props":{},"children":[["The configuration, ",{"tag":"code","props":{},"children":["jfdevelops.json"]},", will be rewritten"]]}]]}]]}]]},"\n",{"tag":"mdx:h2","props":{"id":"conflicts"},"children":["Conflicts"]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Conflict"]},{"tag":"th","props":{},"children":["Why it happens"]},{"tag":"th","props":{},"children":["Choices"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Edited after the CLI last wrote it"]},{"tag":"td","props":{},"children":["You or a tool changed a managed copy"]},{"tag":"td","props":{},"children":["Keep the file, or replace it with the planned content"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Exists and is not managed by the CLI"]},{"tag":"td","props":{},"children":["A file the CLI wants to create is already there"]},{"tag":"td","props":{},"children":["Keep the file, or replace it"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["No longer needed but edited"]},{"tag":"td","props":{},"children":["A removed skill's copy was edited"]},{"tag":"td","props":{},"children":["Keep the file, or delete it"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Managed for something outside this setup"]},{"tag":"td","props":{},"children":["Another skill or addon owns the path"]},{"tag":"td","props":{},"children":["Kept; resolve the ownership first"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["A directory or link, not a file"]},{"tag":"td","props":{},"children":["Something other than a file is at the path"]},{"tag":"td","props":{},"children":["Kept; the CLI never writes through links"]}]]}]]}]]},"\n",{"tag":"p","props":{},"children":[["Conflicts come up in every command that writes files, not only skill commands. With ",{"tag":"code","props":{},"children":["--yes"]},", ",{"tag":"code","props":{},"children":["--conflicts overwrite"]}," replaces or deletes every overwritable conflict, which are the first three rows; the last two are always kept. Paths that resolve outside the project are rejected."]]},"\n",{"tag":"p","props":{},"children":[["Kept conflicts stay recorded under their previous state, so the next ",{"tag":"code","props":{},"children":["skills"]}," run reports them again until they are resolved. Run the command again to retry files that failed."]]},"\n",{"tag":"mdx:h2","props":{"id":"instruction-files"},"children":["Instruction files"]},"\n",{"tag":"p","props":{},"children":[["The CLI only edits text between ",{"tag":"code","props":{},"children":["<!-- jfdevelops:start -->"]}," and ",{"tag":"code","props":{},"children":["<!-- jfdevelops:end -->"]},". Everything else in ",{"tag":"code","props":{},"children":["AGENTS.md"]},", ",{"tag":"code","props":{},"children":["CLAUDE.md"]},", ",{"tag":"code","props":{},"children":["GEMINI.md"]},", and ",{"tag":"code","props":{},"children":[".github/copilot-instructions.md"]}," is yours and preserved, including line endings. When the CLI creates ",{"tag":"code","props":{},"children":["AGENTS.md"]}," it starts with ",{"tag":"code","props":{},"children":["# Project agent instructions"]},", and for ",{"tag":"code","props":{},"children":["CLAUDE.md"]}," with ",{"tag":"code","props":{},"children":["# Project instructions"]},". A file with only one of the two markers stops the command until it is fixed. Generated projects keep Prettier and Biome away from skill copies, ",{"tag":"code","props":{},"children":["jfdevelops.json"]},", and lockfiles, which the CLI and package managers rewrite."]]},"\n",{"tag":"mdx:h2","props":{"id":"compare-with-upstream-main"},"children":["Compare with upstream main"]},"\n",{"tag":"p","props":{},"children":[["Run ",{"tag":"code","props":{},"children":["jfdevelops skills outdated [directory]"]}," to compare the project's installed ",{"tag":"code","props":{},"children":[".agents/skills"]}," copies with the registered skills in ",{"tag":"code","props":{},"children":["https://github.com/jfdevelops/skills"]}," on ",{"tag":"code","props":{},"children":["main"]},". This command works without ",{"tag":"code","props":{},"children":["jfdevelops.json"]}," or installed npm dependencies. It compares skills by name and checks every bundled file, including references, missing resources, and extra local resources. Skills absent from the upstream catalog are reported as not compared."]]},"\n",{"tag":"p","props":{},"children":[["The command clones a temporary snapshot, reports its commit, and removes the snapshot afterward. It makes no changes to project files. An ",{"tag":"code","props":{},"children":["outdated"]}," result means content differs; differences may include local edits or unreleased changes on ",{"tag":"code","props":{},"children":["main"]},", so it does not mean a package upgrade is pending. Run ",{"tag":"code","props":{},"children":["jfdevelops skills sync"]}," to bring the shared skill copies to the current ",{"tag":"code","props":{},"children":["main"]},"."]]},"\n",{"tag":"p","props":{},"children":[["Use ",{"tag":"code","props":{},"children":["jfdevelops skills outdated --check"]}," in CI: it exits with code 1 for differences or a failed comparison and code 0 otherwise. Without ",{"tag":"code","props":{},"children":["--check"]},", differences are informational; failures still exit with code 1. With no installed skills, it reports that fact without accessing the network."]]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"commands.md#skills-directory"},"children":[["Look up ",{"tag":"code","props":{},"children":["skills"]}," commands"]]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"addons.md"},"children":["Adopt addons and their skills"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"authoring.md"},"children":["Publish skills from a library"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"configuration.md"},"children":[["Understand ",{"tag":"code","props":{},"children":["jfdevelops.json"]}]]},"."]]},"\n"]]}],"toc":[{"title":"Where skills come from","url":"#where-skills-come-from","depth":2},{"title":"Where skills are installed","url":"#where-skills-are-installed","depth":2},{"title":"Check skill status","url":"#check-skill-status","depth":2},{"title":"Sync after an upgrade","url":"#sync-after-an-upgrade","depth":2},{"title":"Update skill sources","url":"#update-skill-sources","depth":2},{"title":"Upgrade from earlier releases","url":"#upgrade-from-earlier-releases","depth":2},{"title":"How the CLI tells your edits from its own files","url":"#how-the-cli-tells-your-edits-from-its-own-files","depth":2},{"title":"Read a planned change","url":"#read-a-planned-change","depth":2},{"title":"Conflicts","url":"#conflicts","depth":2},{"title":"Instruction files","url":"#instruction-files","depth":2},{"title":"Compare with upstream main","url":"#compare-with-upstream-main","depth":2},{"title":"Next steps","url":"#next-steps","depth":2}]}