t"]}," require ",{"tag":"code","props":{},"children":["--yes"]},", and ",{"tag":"code","props":{},"children":["create"]}," also requires ",{"tag":"code","props":{},"children":["--kind"]}," and a name argument. In a terminal, the choice flags apply only together with ",{"tag":"code","props":{},"children":["--yes"]},"; without it, the command prompts and ignores them. ",{"tag":"code","props":{},"children":["--conflicts keep"]}," (the default) or ",{"tag":"code","props":{},"children":["--conflicts overwrite"]}," chooses how unattended setup handles overwritable conflicts, and also applies only with ",{"tag":"code","props":{},"children":["--yes"]},". Other mutating commands require a terminal. The status and listing commands ",{"tag":"code","props":{},"children":["skills"]},", ",{"tag":"code","props":{},"children":["skills outdated"]},", and ",{"tag":"code","props":{},"children":["add --list"]}," work without prompts."]]},"\n",{"tag":"p","props":{},"children":[["Read ",{"tag":"mdx:a","props":{"href":"skills.md#check-skill-status"},"children":["Check skill status"]}," before adding ",{"tag":"code","props":{},"children":["skills --check"]}," to CI, because it fails on new upstream commits to the shared skills."]]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"getting-started.md"},"children":["Create or adopt a project"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"commands.md"},"children":["Look up command options"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"skills.md"},"children":["Check and synchronize skills"]},"."]]},"\n"]]}],"toc":[{"title":"Check the prerequisites","url":"#check-the-prerequisites","depth":2},{"title":"Run without installing","url":"#run-without-installing","depth":2},{"title":"Add a project dependency","url":"#add-a-project-dependency"