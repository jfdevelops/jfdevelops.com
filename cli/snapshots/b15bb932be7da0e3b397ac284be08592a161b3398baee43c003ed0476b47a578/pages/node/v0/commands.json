{"schemaVersion":1,"framework":"node","version":"v0","id":"commands","title":"Command reference","description":"Look up commands, options, terminal requirements, and exit codes.","body":[{"tag":"p","props":{},"children":[["Run commands with ",{"tag":"code","props":{},"children":["npx @jfdevelops/cli <command>"]},", or ",{"tag":"code","props":{},"children":["jfdevelops <command>"]}," once the CLI is a dependency of the project. ",{"tag":"code","props":{},"children":["jfdevelops --help"]}," and ",{"tag":"code","props":{},"children":["jfdevelops <command> --help"]}," list every option."]]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Command"]},{"tag":"th","props":{},"children":["What it does"]},{"tag":"th","props":{},"children":["Needs a terminal"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["create [name]"]}]},{"tag":"td","props":{},"children":["Create an app or library from a template"]},{"tag":"td","props":{},"children":[["Yes, unless ",{"tag":"code","props":{},"children":["--yes"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["create skills"]}]},{"tag":"td","props":{},"children":["Register or scaffold skills in a library package and verify they are published"]},{"tag":"td","props":{},"children":["Yes"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["init [directory]"]}]},{"tag":"td","props":{},"children":["Adopt an existing project"]},{"tag":"td","props":{},"children":[["Yes, unless ",{"tag":"code","props":{},"children":["--yes"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["add"]}]},{"tag":"td","props":{},"children":["Browse and choose an addition"]},{"tag":"td","props":{},"children":["Yes"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["add --list"]}]},{"tag":"td","props":{},"children":["List compatible additions without changing anything"]},{"tag":"td","props":{},"children":["No"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["add skill <name>"]}]},{"tag":"td","props":{},"children":["Enable one skill from an installed package"]},{"tag":"td","props":{},"children":["Yes"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["add addon <name>"]}]},{"tag":"td","props":{},"children":["Adopt or install an integration and offer its skills"]},{"tag":"td","props":{},"children":["Yes"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["add package <name>"]}]},{"tag":"td","props":{},"children":[["Scaffold a TypeScript library in the workspace, with ",{"tag":"code","props":{},"children":["src/"]},", ",{"tag":"code","props":{},"children":["test/"]},", and Vite+ tasks"]]},{"tag":"td","props":{},"children":["Yes"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["update [directory]"]}]},{"tag":"td","props":{},"children":["Upgrade the CLI and refresh managed project setup"]},{"tag":"td","props":{},"children":["Yes"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["skills update [skills...]"]}]},{"tag":"td","props":{},"children":["Update all enabled skills or selected names from published packages"]},{"tag":"td","props":{},"children":["Yes"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["skills [directory]"]}]},{"tag":"td","props":{},"children":["Report whether enabled skills match installed versions"]},{"tag":"td","props":{},"children":["No"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["skills sync [directory]"]}]},{"tag":"td","props":{},"children":["Update skill copies to the installed versions"]},{"tag":"td","props":{},"children":["Yes"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["skills outdated [directory]"]}]},{"tag":"td","props":{},"children":["Compare skill copies with upstream main"]},{"tag":"td","props":{},"children":["No"]}]]}]]}]]},"\n",{"tag":"p","props":{},"children":[[{"tag":"code","props":{},"children":["create"]}," and ",{"tag":"code","props":{},"children":["init"]}," accept ",{"tag":"code","props":{},"children":["--yes"]}," so agents and scripts can run them without a terminal. Other mutating commands still refuse to run without a terminal and exit with code 1."]]},"\n",{"tag":"mdx:h2","props":{"id":"exit-codes"},"children":["Exit codes"]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Code"]},{"tag":"th","props":{},"children":["Meaning"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["0"]},{"tag":"td","props":{},"children":["Finished, including when nothing needed to change or you cancelled"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["1"]},{"tag":"td","props":{},"children":[["Failed, finished with errors on some files, or was run without a required terminal; ",{"tag":"code","props":{},"children":["skills --check"]}," also uses 1 when skills need syncing"]]}]]}]]}]]},"\n",{"tag":"mdx:h2","props":{"id":"create-name"},"children":[{"tag":"code","props":{},"children":["create [name]"]}]},"\n",{"tag":"p","props":{},"children":[["The optional argument is the package name. It is also the destination: ",{"tag":"code","props":{},"children":["create my-project"]}," creates ",{"tag":"code","props":{},"children":["./my-project"]},", and ",{"tag":"code","props":{},"children":["create @acme/site"]}," names the package ",{"tag":"code","props":{},"children":["@acme/site"]}," in ",{"tag":"code","props":{},"children":["./site"]},". Use ",{"tag":"code","props":{},"children":["."]}," to create the project in the current directory, named after that directory. The destination may already contain files; differing paths are offered as conflicts. A destination that already has ",{"tag":"code","props":{},"children":["jfdevelops.json"]}," is refused—use ",{"tag":"code","props":{},"children":["init"]}," to adopt that project instead."]]},"\n",{"tag":"p","props":{},"children":[["When the argument gives a valid package name, ",{"tag":"code","props":{},"children":["create"]}," does not ask for the name or destination. Otherwise it prompts for them, along with app or library, template, package manager, formatter, coding agents, and Git initialization. When Git is initialized it also offers to add a remote: paste an ",{"tag":"code","props":{},"children":["https://"]},", ",{"tag":"code","props":{},"children":["ssh://"]},", or ",{"tag":"code","props":{},"children":["git@host:path"]}," URL, or press Enter to skip. The URL is added as ",{"tag":"code","props":{},"children":["origin"]}," and nothing is pushed."]]},"\n",{"tag":"mdx:h3","props":{"id":"non-interactive-flags"},"children":["Non-interactive flags"]},"\n",{"tag":"p","props":{},"children":[["Pass ",{"tag":"code","props":{},"children":["--yes"]}," to apply the plan without prompts. ",{"tag":"code","props":{},"children":["--kind"]}," is required; other choices use the defaults below. Without a terminal, ",{"tag":"code","props":{},"children":["--yes"]}," is required."]]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Option"]},{"tag":"th","props":{},"children":["Default"]},{"tag":"th","props":{},"children":["Notes"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--kind <app|library>"]}]},{"tag":"td","props":{},"children":["required"]},{"tag":"td","props":{},"children":[null]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--template <name>"]}]},{"tag":"td","props":{},"children":["the only template for that kind"]},{"tag":"td","props":{},"children":["Must match the kind"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--package-manager <name>"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["pnpm"]}]},{"tag":"td","props":{},"children":[[{"tag":"code","props":{},"children":["pnpm"]},", ",{"tag":"code","props":{},"children":["npm"]},", ",{"tag":"code","props":{},"children":["yarn"]},", or ",{"tag":"code","props":{},"children":["bun"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--formatter <name>"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["prettier"]}]},{"tag":"td","props":{},"children":[[{"tag":"code","props":{},"children":["prettier"]}," or ",{"tag":"code","props":{},"children":["biome"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--agents <list>"]}]},{"tag":"td","props":{},"children":["all agents"]},{"tag":"td","props":{},"children":[["Comma-separated: ",{"tag":"code","props":{},"children":["claude-code"]},", ",{"tag":"code","props":{},"children":["codex"]},", ",{"tag":"code","props":{},"children":["cursor"]},", ",{"tag":"code","props":{},"children":["copilot"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[[{"tag":"code","props":{},"children":["--git"]}," / ",{"tag":"code","props":{},"children":["--no-git"]}]]},{"tag":"td","props":{},"children":["initialize Git"]},{"tag":"td","props":{},"children":[null]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--remote <url>"]}]},{"tag":"td","props":{},"children":["none"]},{"tag":"td","props":{},"children":["Only with Git initialization"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--monorepo"]}]},{"tag":"td","props":{},"children":["off"]},{"tag":"td","props":{},"children":["App workspaces only"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--workspace"]}]},{"tag":"td","props":{},"children":["off"]},{"tag":"td","props":{},"children":["Library workspaces only"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--namespace <name>"]}]},{"tag":"td","props":{},"children":["same as interactive"]},{"tag":"td","props":{},"children":[["Or ",{"tag":"code","props":{},"children":["none"]}," for bare names"]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--app-name <name>"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["web"]}]},{"tag":"td","props":{},"children":[["With ",{"tag":"code","props":{},"children":["--monorepo"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--apps-dir <path>"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["apps"]}]},{"tag":"td","props":{},"children":[["With ",{"tag":"code","props":{},"children":["--monorepo"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--libraries-dir <path>"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["packages"]}]},{"tag":"td","props":{},"children":[["With ",{"tag":"code","props":{},"children":["--monorepo"]}," or ",{"tag":"code","props":{},"children":["--workspace"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--packages <list>"]}]},{"tag":"td","props":{},"children":[["none / ",{"tag":"code","props":{},"children":["core"]}," for ",{"tag":"code","props":{},"children":["--workspace"]}]]},{"tag":"td","props":{},"children":["Comma-separated library short names"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["-y, --yes"]}]},{"tag":"td","props":{},"children":[null]},{"tag":"td","props":{},"children":["Apply without confirming"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--conflicts <keep|overwrite>"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["keep"]}]},{"tag":"td","props":{},"children":["How to treat overwritable conflicts"]}]]}]]}]]},"\n",{"tag":"p","props":{},"children":[["Example: ",{"tag":"code","props":{},"children":["jfdevelops create my-app --kind app --yes"]},"."]]},"\n",{"tag":"p","props":{},"children":["Templates:"]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Template"]},{"tag":"th","props":{},"children":["Kind"]},{"tag":"th","props":{},"children":["Contents"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["node-app"]}]},{"tag":"td","props":{},"children":["App"]},{"tag":"td","props":{},"children":["Private TypeScript application compiled for Node.js"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["typescript-library"]}]},{"tag":"td","props":{},"children":["Library"]},{"tag":"td","props":{},"children":["Publishable ESM library with type declarations"]}]]}]]}]]},"\n",{"tag":"p","props":{},"children":[["Both include the selected formatter (Prettier or Biome) and an ESLint Stylistic policy that enforces the shared spacing and brace rules through ",{"tag":"code","props":{},"children":["format"]}," and ",{"tag":"code","props":{},"children":["format:check"]}," scripts."]]},"\n",{"tag":"p","props":{},"children":[["Before you confirm, ",{"tag":"code","props":{},"children":["create"]}," shows the layout it will write as a folder tree (generated agent and skill files are summarized) above the list of changes."]]},"\n",{"tag":"mdx:h3","props":{"id":"monorepo"},"children":["Monorepo"]},"\n",{"tag":"p","props":{},"children":[["Choosing an app also offers a ",{"tag":"strong","props":{},"children":["Monorepo"]}," option (space to select, Enter to confirm). It creates a private workspace root named after the project, with the formatter, ESLint policy, and CLI dependency at the root, and the app in its own package. You are asked for:"]]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Prompt"]},{"tag":"th","props":{},"children":["Default"]},{"tag":"th","props":{},"children":["Result"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Namespace"]},{"tag":"td","props":{},"children":["the project name, or the scope of a scoped project name"]},{"tag":"td","props":{},"children":[[{"tag":"code","props":{},"children":["acme"]}," gives package names such as ",{"tag":"code","props":{},"children":["acme-web"]},"; ",{"tag":"code","props":{},"children":["@acme"]}," gives ",{"tag":"code","props":{},"children":["@acme/web"]},"; ",{"tag":"code","props":{},"children":["none"]}," gives bare names"]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["App name"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["web"]}]},{"tag":"td","props":{},"children":[["The package name is the namespace plus this name, and the directory is ",{"tag":"code","props":{},"children":["apps/<name>"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Apps directory"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["apps"]}]},{"tag":"td","props":{},"children":["Where apps live"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Libraries directory"]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["packages"]}]},{"tag":"td","props":{},"children":["Where libraries live"]}]]}]]}]]},"\n",{"tag":"p","props":{},"children":[["After the directories, ",{"tag":"strong","props":{},"children":["Do you want to add a package?"]}," lets you add libraries. Answer yes and type a name (the first has the grey default ",{"tag":"code","props":{},"children":["core"]},"); ",{"tag":"code","props":{},"children":["create"]}," shows where it will be created, such as ",{"tag":"code","props":{},"children":["Added packages/utils (acme-utils)"]},", then asks whether to add another. Names that are invalid or already used in the workspace are asked for again. Libraries next to an app are private."]]},"\n",{"tag":"p","props":{},"children":[["The workspace is defined in ",{"tag":"code","props":{},"children":["pnpm-workspace.yaml"]}," for pnpm and in the ",{"tag":"code","props":{},"children":["workspaces"]}," field of ",{"tag":"code","props":{},"children":["package.json"]}," for npm, yarn, and bun. The root ",{"tag":"code","props":{},"children":["packageManager"]}," field records the package manager version you created it with. Each package is recorded as a target in ",{"tag":"code","props":{},"children":["jfdevelops.json"]},". Packages build on their own until you link them with workspace dependencies. Use ",{"tag":"code","props":{},"children":["add package"]}," to add libraries afterwards."]]},"\n",{"tag":"mdx:h4","props":{"id":"packages-and-tasks"},"children":["Packages and tasks"]},"\n",{"tag":"p","props":{},"children":[["Workspaces use ",{"tag":"mdx:a","props":{"href":"https://viteplus.dev"},"children":["Vite+"]},". Every package has its sources in ",{"tag":"code","props":{},"children":["src/"]}," (a stub ",{"tag":"code","props":{},"children":["index.ts"]},") and its tests in ",{"tag":"code","props":{},"children":["test/"]}," (a stub ",{"tag":"code","props":{},"children":["index.test.ts"]}," that imports from ",{"tag":"code","props":{},"children":["vite-plus/test"]},"), with a ",{"tag":"code","props":{},"children":["tsconfig.json"]}," that type checks both and a ",{"tag":"code","props":{},"children":["tsconfig.build.json"]}," for the compiled sources. Each package's ",{"tag":"code","props":{},"children":["vite.config.ts"]}," defines three cached tasks:"]]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Task"]},{"tag":"th","props":{},"children":["Library"]},{"tag":"th","props":{},"children":["App"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["build"]}]},{"tag":"td","props":{},"children":[[{"tag":"code","props":{},"children":["vp pack"]}," (tsdown) to ",{"tag":"code","props":{},"children":["dist/index.mjs"]}," and ",{"tag":"code","props":{},"children":["dist/index.d.mts"]}]]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["tsc -p tsconfig.build.json"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["typecheck"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["tsc"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["tsc"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["test"]}]},{"tag":"td","props":{},"children":[[{"tag":"code","props":{},"children":["vp test run"]}," (Vitest)"]]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["vp test run"]}]}]]}]]}]]},"\n",{"tag":"p","props":{},"children":[["Each task first builds the workspace packages its package depends on. The root ",{"tag":"code","props":{},"children":["build"]},", ",{"tag":"code","props":{},"children":["typecheck"]},", and ",{"tag":"code","props":{},"children":["test"]}," scripts run these tasks in every package with ",{"tag":"code","props":{},"children":["vp run -r"]},". A task whose inputs have not changed replays from the Vite+ cache instead of running again."]]},"\n",{"tag":"mdx:h4","props":{"id":"ci"},"children":["CI"]},"\n",{"tag":"p","props":{},"children":[["Workspaces also get ",{"tag":"code","props":{},"children":[".github/workflows/ci.yml"]},". It installs Vite+, Node.js, and your package manager with ",{"tag":"code","props":{},"children":["voidzero-dev/setup-vp"]},", then checks formatting. Next, ",{"tag":"code","props":{},"children":["scripts/run-affected.mjs"]}," runs ",{"tag":"code","props":{},"children":["typecheck"]},", ",{"tag":"code","props":{},"children":["test"]},", and ",{"tag":"code","props":{},"children":["build"]}," only in the packages a change affects. It compares with the pull request's base, or with the previous commit on pushes to ",{"tag":"code","props":{},"children":["main"]},", and selects each package that has changed files, along with the packages that depend on it, through ",{"tag":"code","props":{},"children":["vp run --filter \"...{<directory>}\""]},". Changes only to Markdown, ",{"tag":"code","props":{},"children":[".agents/"]},", ",{"tag":"code","props":{},"children":[".claude/"]},", or ",{"tag":"code","props":{},"children":["jfdevelops.json"]}," run nothing. A change outside every package, such as the lockfile or root configuration, runs the tasks everywhere, and so does a base that cannot be compared. The workflow also restores and saves the Vite Task cache (",{"tag":"code","props":{},"children":["node_modules/.vite/task-cache"]},") between runs. Run ",{"tag":"code","props":{},"children":["BASE_SHA=<commit> node scripts/run-affected.mjs typecheck test build"]}," to do the same locally."]]},"\n",{"tag":"mdx:h3","props":{"id":"library-workspace"},"children":["Library workspace"]},"\n",{"tag":"p","props":{},"children":[["Choosing a library asks ",{"tag":"strong","props":{},"children":["Do you want to add a package?"]}," first. No keeps a single package, as before. Yes makes the project a private workspace root with only a libraries directory: you choose the namespace (default ",{"tag":"code","props":{},"children":["@<project name>"]},", so ",{"tag":"code","props":{},"children":["acme"]}," gives ",{"tag":"code","props":{},"children":["@acme/core"]},"), the libraries directory (default ",{"tag":"code","props":{},"children":["packages"]},"), and then name each library in the same add-another loop. Libraries in a library workspace are publishable, and each is recorded as a library target in ",{"tag":"code","props":{},"children":["jfdevelops.json"]},"."]]},"\n",{"tag":"mdx:h2","props":{"id":"create-skills"},"children":[{"tag":"code","props":{},"children":["create skills"]}]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Option"]},{"tag":"th","props":{},"children":["Description"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--package <name>"]}]},{"tag":"td","props":{},"children":["The workspace package that owns the skills; otherwise you choose, or the only library is used"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--path <skill-directory>"]}]},{"tag":"td","props":{},"children":[["Register this directory, or scaffold a skill there when it has no ",{"tag":"code","props":{},"children":["SKILL.md"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["-d, --directory <path>"]}]},{"tag":"td","props":{},"children":[["Project directory (default ",{"tag":"code","props":{},"children":["."]},")"]]}]]}]]}]]},"\n",{"tag":"p","props":{},"children":[["See ",{"tag":"mdx:a","props":{"href":"authoring.md"},"children":["authoring skills"]},"."]]},"\n",{"tag":"mdx:h2","props":{"id":"init-directory"},"children":[{"tag":"code","props":{},"children":["init [directory]"]}]},"\n",{"tag":"p","props":{},"children":["Detects the project, confirms target types and integrations, lets you choose skills and the coding agents that load them, previews every change with conflicts, applies it after confirmation, and records the setup. It also adds the CLI as an exact development dependency when it is missing."]},"\n",{"tag":"mdx:h3","props":{"id":"non-interactive-flags-1"},"children":["Non-interactive flags"]},"\n",{"tag":"p","props":{},"children":[["Pass ",{"tag":"code","props":{},"children":["--yes"]}," to apply without prompts. Without a terminal, ",{"tag":"code","props":{},"children":["--yes"]}," is required. Omitted selection flags install or adopt everything available."]]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Option"]},{"tag":"th","props":{},"children":["Default"]},{"tag":"th","props":{},"children":["Notes"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--package-manager <name>"]}]},{"tag":"td","props":{},"children":["detected"]},{"tag":"td","props":{},"children":["Required only when the package manager cannot be detected"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--agents <list>"]}]},{"tag":"td","props":{},"children":["all agents"]},{"tag":"td","props":{},"children":["Comma-separated agent names"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--addons <list>"]}]},{"tag":"td","props":{},"children":["all detected integrations"]},{"tag":"td","props":{},"children":["Comma-separated integration names"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--skills <list>"]}]},{"tag":"td","props":{},"children":["all available skills"]},{"tag":"td","props":{},"children":[["Comma-separated skill names; use ",{"tag":"code","props":{},"children":["package:name"]}," when a name is provided by more than one package"]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["-y, --yes"]}]},{"tag":"td","props":{},"children":[null]},{"tag":"td","props":{},"children":["Apply without confirming"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--conflicts <keep|overwrite>"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["keep"]}]},{"tag":"td","props":{},"children":["How to treat overwritable conflicts"]}]]}]]}]]},"\n",{"tag":"p","props":{},"children":[["Detected target kinds are accepted as-is. If a target kind is unknown, run interactively. Example: ",{"tag":"code","props":{},"children":["jfdevelops init --yes"]},"."]]},"\n",{"tag":"mdx:h2","props":{"id":"add"},"children":[{"tag":"code","props":{},"children":["add"]}]},"\n",{"tag":"p","props":{},"children":[["All ",{"tag":"code","props":{},"children":["add"]}," commands accept ",{"tag":"code","props":{},"children":["-d, --directory <path>"]}," (default ",{"tag":"code","props":{},"children":["."]},")."]]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":[{"tag":"code","props":{},"children":["add --list"]}]}," prints available skills with their source and the workspace packages that can use them, addons that are installed but not adopted or that can be installed, and whether ",{"tag":"code","props":{},"children":["add package"]}," is available."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":[{"tag":"code","props":{},"children":["add skill <name>"]}]}," asks which source to use when more than one package or version provides the name."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":[{"tag":"code","props":{},"children":["add addon <name>"]}]}," accepts ",{"tag":"code","props":{},"children":["convex"]},", ",{"tag":"code","props":{},"children":["docs"]},", ",{"tag":"code","props":{},"children":["portless"]},", or an individual ",{"tag":"code","props":{},"children":["@tanstack/*"]}," or ",{"tag":"code","props":{},"children":["@jfdevelops/*"]}," library. An installed integration is adopted as is; otherwise the package is installed with your package manager after confirmation (Portless as a development dependency). Its skills are then offered. Addon skills never appear elsewhere until the addon is enabled."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":[{"tag":"code","props":{},"children":["add addon docs"]}]}," installs ",{"tag":"code","props":{},"children":["@jfdevelops/docs"]}," as a development dependency, asks which package the docs describe and the library name, and records both as the addon's options in ",{"tag":"code","props":{},"children":["jfdevelops.json"]},". It adds the ",{"tag":"code","props":{},"children":["docs:generate"]}," and ",{"tag":"code","props":{},"children":["docs:check"]}," scripts (keeping any existing script of the same name), ignores the generated ",{"tag":"code","props":{},"children":["docs/docs.json"]}," and ",{"tag":"code","props":{},"children":["meta.json"]}," files, starts ",{"tag":"code","props":{},"children":["docs/README.md"]}," when there is none, and adds ",{"tag":"code","props":{},"children":[".github/workflows/docs.yml"]},". That workflow generates and checks the docs only when the docs, the documented package, ",{"tag":"code","props":{},"children":["jfdevelops.json"]},", or the workflow change. The workflow is managed by the addon, so local edits to it go through conflict review."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":[{"tag":"code","props":{},"children":["add package <name>"]}]}," needs a workspace (",{"tag":"code","props":{},"children":["pnpm-workspace.yaml"]}," or ",{"tag":"code","props":{},"children":["package.json"]}," workspaces). It suggests a directory from your workspace patterns, adds the directory to the workspace when no pattern covers it, and records the package as a library target. Run your package manager's install afterwards to link it."]]},"\n"]]},"\n",{"tag":"mdx:h2","props":{"id":"skills-directory"},"children":[{"tag":"code","props":{},"children":["skills [directory]"]}]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Option"]},{"tag":"th","props":{},"children":["Description"]}]]}]},{"tag":"tbody","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["--check"]}]},{"tag":"td","props":{},"children":["Exit with code 1 when anything needs syncing, for CI"]}]]}]}]]},"\n",{"tag":"mdx:h2","props":{"id":"skills-sync-directory"},"children":[{"tag":"code","props":{},"children":["skills sync [directory]"]}]},"\n",{"tag":"p","props":{},"children":[["Uses the coding agents recorded in ",{"tag":"code","props":{},"children":["jfdevelops.json"]},"; run ",{"tag":"code","props":{},"children":["init"]}," again to change them. Offers to remove skills whose package is gone, asks which version to use when a skill is installed in several versions, previews the updates, and asks about each locally edited copy. See ",{"tag":"mdx:a","props":{"href":"skills.md"},"children":["skills and conflicts"]},"."]]},"\n",{"tag":"mdx:h3","props":{"id":"skills-outdated-directory"},"children":[{"tag":"code","props":{},"children":["skills outdated [directory]"]}]},"\n",{"tag":"p","props":{},"children":[["Read-only comparison of installed ",{"tag":"code","props":{},"children":[".agents/skills"]}," resources against the registered skills on ",{"tag":"code","props":{},"children":["jfdevelops/skills"]},"'s ",{"tag":"code","props":{},"children":["main"]}," branch. Defaults to the current directory; requires Git and network access, but no terminal or project configuration. Reports the upstream commit and the changed paths for each matching skill. Unmatched skills are reported as not compared."]]},"\n",{"tag":"p","props":{},"children":[[{"tag":"code","props":{},"children":["--check"]}," exits with code 1 when compared skills differ; otherwise differences are informational. Comparison failures always exit with code 1. No skills installed, or no differences among compared skills, exits with code 0. Local edits count as differences. This command does not install updates."]]},"\n",{"tag":"mdx:h2","props":{"id":"jfdevelops-skills-update-skills"},"children":[{"tag":"code","props":{},"children":["jfdevelops skills update [skills...]"]}]},"\n",{"tag":"p","props":{},"children":[["Updates all enabled skills by default, or only the named skills. Use ",{"tag":"code","props":{},"children":["-d, --directory <path>"]}," to choose a project. The command previews source-package upgrades to ",{"tag":"code","props":{},"children":["latest"]},", asks for confirmation, then reviews the nested file tree and any locally edited skill copies before synchronizing them. Package upgrades change the manifest and lockfile even if the later file review is declined. Multiple skills from the same package share one package upgrade per scope. Local workspace/file sources are not upgraded from the registry. Optional source dependencies must be updated with the package manager before ",{"tag":"code","props":{},"children":["skills sync"]},"."]]},"\n",{"tag":"p","props":{},"children":[[{"tag":"code","props":{},"children":["init"]}," installs the CLI and the shared skills package directly as development dependencies. Planned file changes use a nested tree with folder/file icons and action labels."]]},"\n",{"tag":"mdx:h2","props":{"id":"jfdevelops-update-directory"},"children":[{"tag":"code","props":{},"children":["jfdevelops update [directory]"]}]},"\n",{"tag":"p","props":{},"children":[["Upgrades the project's ",{"tag":"code","props":{},"children":["@jfdevelops/cli"]}," dependency to the latest published release, then runs that installed release to refresh the project. It updates enabled skills, runs init to review newly detected integrations/skills, and regenerates tooling from the project's recorded templates and formatter. The planned file tree and local-edit conflicts are reviewed before tooling is written. Template entry/test stubs are only added when missing; existing application source, tests, README files, workspace membership, and unrelated manifest entries are preserved. Adopted projects without template metadata keep their existing build tooling. Dependencies are installed after tooling changes. Package and file updates already applied are retained if a later step is cancelled or fails; rerun update to retry."]]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"installation.md"},"children":["Install the CLI"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"commands.md"},"children":["Read the command reference"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"skills.md"},"children":["Manage skills and conflicts"]},"."]]},"\n"]]}],"toc":[{"title":"Exit codes","url":"#exit-codes","depth":2},{"title":"create [name]","url":"#create-name","depth":2},{"title":"Non-interactive flags","url":"#non-interactive-flags","depth":3},{"title":"Monorepo","url":"#monorepo","depth":3},{"title":"Packages and tasks","url":"#packages-and-tasks","depth":4},{"title":"CI","url":"#ci","depth":4},{"title":"Library workspace","url":"#library-workspace","depth":3},{"title":"create skills","url":"#create-skills","depth":2},{"title":"init [directory]","url":"#init-directory","depth":2},{"title":"Non-interactive flags","url":"#non-interactive-flags-1","depth":3},{"title":"add","url":"#add","depth":2},{"title":"skills [directory]","url":"#skills-directory","depth":2},{"title":"skills sync [directory]","url":"#skills-sync-directory","depth":2},{"title":"skills outdated [directory]","url":"#skills-outdated-directory","depth":3},{"title":"jfdevelops skills update [skills...]","url":"#jfdevelops-skills-update-skills","depth":2},{"title":"jfdevelops update [directory]","url":"#jfdevelops-update-directory","depth":2},{"title":"Next steps","url":"#next-steps","depth":2}]}