{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jfdevelops",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "src/server.ts",
  "version_metadata": {
    "binding": "VERSION_METADATA"
  },
  // Published by .github/workflows/refresh-docs.yml.
  "r2_buckets": [
    {
      "binding": "DOCS_SNAPSHOTS",
      "bucket_name": "jfdevelops-docs"
    }
  ]
}
