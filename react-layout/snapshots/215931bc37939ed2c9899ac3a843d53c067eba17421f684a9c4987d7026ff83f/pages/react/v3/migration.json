":"code","props":{},"children":["z.string()"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["createProp.number().optional()"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["z.number().optional()"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["createProp.string().literal('a')"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["z.literal('a')"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["createProp.string().enum(['a', 'b'])"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["z.enum(['a', 'b'])"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["createProp.array(createProp.string())"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["z.array(z.string())"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["createProp.object({ name: createProp.string() })"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["z.object({ name: z.string() })"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["createProp.record({ value: createProp.string() })"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["z.record(z.string(), z.string())"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["createProp.component({ type: 'ReactNode' })"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["reactNode()"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["createProp.component({ type: 'JSX.Element' })"]}]},{"tag":"td","props":{},"children":[[{"tag":"code","props":{},"children":["reactElement()"]}," for element values"]]}]]}]]}]]},"\n",{"tag":"p","props":{},"children":[[{"tag":"code","props":{},"children":["reactNode()"]}," and ",{"tag":"code","props":{},"children":["reactElement()"]}," come from the adapter package for your schema library. See ",{"tag":"mdx:a","props":{"href":"./guides/props-and-validation.md#react-values-and-adapters"},"children":["Props and validation"]},"."]]},"\n",{"tag":"mdx:h2","props":{"id":"2-behavior-that-changed"},"children":["2. Behavior that changed"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":["Component slots."]}," Use ",{"tag":"code","props":{},"children":["componentSlot({ props: { label: z.string() } })"]},". A slot named ",{"tag":"code","props":{},"children":["actions"]}," is still supplied and rendered as ",{"tag":"code","props":{},"children":["Actions"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":["Values carried by a definition."]}," A literal definition used to supply its own value. Give the schema a default instead, for example ",{"tag":"code","props":{},"children":["z.literal('docs').default('docs')"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":[[{"tag":"code","props":{},"children":["options"]}," as a function."]]}," ",{"tag":"code","props":{},"children":["options: ({ resource, name }) => ..."]}," still works. Return schemas."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":["Nested reusable selections."]}," ",{"tag":"code","props":{},"children":["options: { meta: { owner: true } }"]}," still works."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":[[{"tag":"code","props":{},"children":["createProp.fromComponent"]},"."]]}," Use ",{"tag":"code","props":{},"children":["createPropsFromComponent(Component).pick(...)"]}," or ",{"tag":"code","props":{},"children":[".omit(...)"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":["Error messages."]}," A failed prop reports the schema's own message as ",{"tag":"code","props":{},"children":["Invalid prop \"<path>\": <message>"]},", including for a missing required prop."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":["Unknown keys."]}," Your schema library now decides whether an object keeps undeclared keys."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":[["Explicit ",{"tag":"code","props":{},"children":["undefined"]},"."]]}," A defined composable uses an explicitly passed prop, even ",{"tag":"code","props":{},"children":["undefined"]},", instead of falling back to the provider value."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":["Devtools."]}," Props show their type and schema vendor where metadata is available. Unknown schemas show ",{"tag":"code","props":{},"children":["unknown"]},". Inspection never validates a value."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":["Breadcrumb segments."]}," The default ",{"tag":"code","props":{},"children":["segments"]}," definition is an ArkType-backed schema exported as ",{"tag":"code","props":{},"children":["BreadcrumbSegmentsSchema"]},". The composables package no longer re-exports ",{"tag":"code","props":{},"children":["createProp"]},"."]]},"\n"]]},"\n",{"tag":"mdx:h2","props":{"id":"3-children-are-implicit"},"children":["3. Children are implicit"]},"\n",{"tag":"p","props":{},"children":[["React components include optional ",{"tag":"code","props":{},"children":["children: ReactNode"]}," automatically, including layouts, shells, render states and scoped components. Delete any ",{"tag":"code","props":{},"children":["props.custom.children: reactNode()"]}," you added. To use a different type, declare a ",{"tag":"code","props":{},"children":["children"]}," schema, which replaces the default. Reusable helpers and option schemas get no implicit children."]]},"\n",{"tag":"mdx:h2","props":{"id":"4-renamed-validator-exports"},"children":["4. Renamed validator exports"]},"\n",{"tag":"p","props":{},"children":[[{"tag":"code","props":{},"children":["@jfdevelops/react-layout-validator"]}," now exports ",{"tag":"code","props":{},"children":["PropDefinition"]},", ",{"tag":"code","props":{},"children":["PropDefinitions"]},", ",{"tag":"code","props":{},"children":["ResolveProps"]},", ",{"tag":"code","props":{},"children":["ResolveInputProps"]},", ",{"tag":"code","props":{},"children":["InputDefinitions"]},", ",{"tag":"code","props":{},"children":["DefinitionVisibility"]},", ",{"tag":"code","props":{},"children":["validateProps"]},", ",{"tag":"code","props":{},"children":["validateDefinition"]},", ",{"tag":"code","props":{},"children":["resolvePropDefinitionValues"]},", ",{"tag":"code","props":{},"children":["isStandardSchema"]}," and ",{"tag":"code","props":{},"children":["PropError"]},". It no longer has a React peer dependency."]]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Old name"]},{"tag":"th","props":{},"children":["New name"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["AnyBuiltPropDefinition"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["PropDefinition"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["BuiltPropShape"]}]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["PropDefinitions"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[[{"tag":"code","props":{},"children":["ResolveLayoutProps"]},", ",{"tag":"code","props":{},"children":["ResolveLayoutPropsAsDefined"]},", ",{"tag":"code","props":{},"children":["ResolvedBuiltPropShape"]}]]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["ResolveProps"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[[{"tag":"code","props":{},"children":["ResolveLayoutInputProps"]},", ",{"tag":"code","props":{},"children":["ResolvedInputShape"]}]]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["ResolveInputProps"]}]}]]}]]}]]},"\n",{"tag":"p","props":{},"children":[[{"tag":"code","props":{},"children":["@jfdevelops/react-layout-internals"]}," exports ",{"tag":"code","props":{},"children":["NonEmptyReadonlyArray"]},". It is private."]]},"\n",{"tag":"mdx:h2","props":{"id":"5-type-changes-that-can-break-compilation"},"children":["5. Type changes that can break compilation"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[["Most large builder types now declare ",{"tag":"strong","props":{},"children":["invariant"]}," type parameters. Assigning one such type to the same type with different arguments, which used to succeed structurally, is now an error. Inferred usage is unaffected."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"code","props":{},"children":["Show"]}," is a plain mapped type and no longer preserves call signatures. Use the new ",{"tag":"code","props":{},"children":["ShowCallable"]}," for types that may be callable. Composables previously reduced a callable ",{"tag":"code","props":{},"children":["Show"]}," to its bare call signature, so check any code relying on that."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"code","props":{},"children":["RenderStateContext"]}," takes ",{"tag":"code","props":{},"children":["<Resources, Composables, States>"]}," and ",{"tag":"code","props":{},"children":["Resources"]}," has no default. It was ",{"tag":"code","props":{},"children":["<Composables, Resources, States>"]},"."]]},"\n",{"tag":"li","props":{},"children":[["Type parameters use one name per slot (",{"tag":"code","props":{},"children":["Options"]},", ",{"tag":"code","props":{},"children":["IncludeProps"]},", ",{"tag":"code","props":{},"children":["CustomProps"]},", ",{"tag":"code","props":{},"children":["Resources"]},"). Positions did not change."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"code","props":{},"children":["CreateViewMapOptions"]}," and related option types are now interfaces over shared bases (",{"tag":"code","props":{},"children":["ResourceLayoutScope"]},", ",{"tag":"code","props":{},"children":["ResourceLayoutConfig"]},"). Layout, render-state and lazy default ",{"tag":"code","props":{},"children":["props"]}," share a ",{"tag":"code","props":{},"children":["PropsContract"]}," interface."]]},"\n"]]},"\n",{"tag":"mdx:h2","props":{"id":"6-smaller-removals"},"children":["6. Smaller removals"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[[{"tag":"code","props":{},"children":["defineLazyDefaults.createErrorComponent"]}," and the ",{"tag":"code","props":{},"children":["CreateLazyErrorComponent"]}," type were removed. Use ",{"tag":"code","props":{},"children":["defineLazyDefaults.createRenderState({ state: 'Error', render })"]},", which accepts the same render callback or code-keyed handlers. Declare custom props in ",{"tag":"code","props":{},"children":["props.custom"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"code","props":{},"children":["defineResourceLayout.withLayout"]}," now accepts ",{"tag":"code","props":{},"children":["name"]},". It was honored at runtime but missing from the types."]]},"\n"]]},"\n",{"tag":"mdx:h2","props":{"id":"checklist"},"children":["Checklist"]},"\n",{"tag":"ol","props":{},"children":[["\n",{"tag":"li","props":{},"children":["Install an adapter for your schema library."]},"\n",{"tag":"li","props":{},"children":[["Replace each ",{"tag":"code","props":{},"children":["createProp"]}," call using the table above."]]},"\n",{"tag":"li","props":{},"children":["Replace imports of removed validator types."]},"\n",{"tag":"li","props":{},"children":[["Run your type check and fix invariance and ",{"tag":"code","props":{},"children":["Show"]}," errors."]]},"\n",{"tag":"li","props":{},"children":[["Remove explicit ",{"tag":"code","props":{},"children":["children"]}," declarations you no longer need."]]},"\n"]]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"./guides/props-and-validation.md"},"children":["Props and validation"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"./troubleshooting.md"},"children":["Troubleshooting"]}]},"\n",{"tag":"li","props":{},"children":[["Next major: ",{"tag":"mdx:a","props":{"href":"../v4/guides/migration.md"},"children":["v3 to v4"]}]]},"\n"]]}],"toc":[{"title":"Upgrade the package","url":"#upgrade-the-package","depth":2},{"title":"1. Replace createProp","url":"#1-replace-createprop","depth":2},{"title":"2. Behavior that changed","url":"#2-behavior-that-changed","depth":2},{"title":"3. Children are implicit","url":"#3-children-are-implicit","depth":2},{"title":"4. Renamed validator exports","url":"#4-renamed-validator-exports","depth":2},{"title":"5. Type changes that can break compilation","url":"#5-type-changes-that-can-break-compilation","depth":2},{"title":"6. Smaller removals","url":"#6-smaller-removals","depth":2},{"title":"Checklist","url":"#checklist","depth":2},{"title":"Next steps","url":"#next-steps","depth":2}]}