{"schemaVersion":1,"framework":"react","version":"v0","id":"errors/prop","title":"PropError","description":"When PropError occurs and how to resolve it.","body":[{"tag":"p","props":{},"children":["A required prop is missing or a supplied prop fails its definition during runtime validation."]},"\n",{"tag":"mdx:h2","props":{"id":"identify-the-error"},"children":["Identify the error"]},"\n",{"tag":"p","props":{},"children":[["The error code is ",{"tag":"code","props":{},"children":["invalidProp"]},". This error belongs to the validator package and is not part of the ",{"tag":"code","props":{},"children":["ReactLayoutError"]}," hierarchy."]]},"\n",{"tag":"mdx:h2","props":{"id":"resolve-the-error"},"children":["Resolve the error"]},"\n",{"tag":"p","props":{},"children":["Inspect path, layoutName, resource, received and expected to locate the invalid value. Correct the input or its definition."]},"\n",{"tag":"mdx:h2","props":{"id":"release-scope"},"children":["Release scope"]},"\n",{"tag":"p","props":{},"children":[["This page describes ",{"tag":"code","props":{},"children":["@jfdevelops/react-layout@0.25.0"]},". Earlier 0.x releases can differ. The behavior is based on the error definitions and their call sites in ",{"tag":"mdx:a","props":{"href":"https://github.com/jfdevelops/react-layout/blob/%40jfdevelops%2Freact-layout%400.25.0/packages/validators/src/prop-error.ts"},"children":["the tagged source"]},"."]]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../final-snapshot.md"},"children":["Final snapshot"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../standard-schema.md"},"children":["Standard Schema"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../reference/api.md"},"children":["API reference"]}]},"\n"]]}],"toc":[{"title":"Identify the error","url":"#identify-the-error","depth":2},{"title":"Resolve the error","url":"#resolve-the-error","depth":2},{"title":"Release scope","url":"#release-scope","depth":2},{"title":"Next steps","url":"#next-steps","depth":2}]}