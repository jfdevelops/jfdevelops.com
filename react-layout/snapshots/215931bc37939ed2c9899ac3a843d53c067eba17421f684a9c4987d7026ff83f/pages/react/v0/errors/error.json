{"schemaVersion":1,"framework":"react","version":"v0","id":"errors/error","title":"Error","description":"When Error occurs and how to resolve it.","body":[{"tag":"p","props":{},"children":["A lazy render-state module exports zero or multiple library-defined render states."]},"\n",{"tag":"mdx:h2","props":{"id":"identify-the-error"},"children":["Identify the error"]},"\n",{"tag":"p","props":{},"children":["This is a native JavaScript error."]},"\n",{"tag":"mdx:h2","props":{"id":"resolve-the-error"},"children":["Resolve the error"]},"\n",{"tag":"p","props":{},"children":["Export exactly one defined render state. The message reports the number found. The loader can wrap this failure in ResourceModuleLoadError."]},"\n",{"tag":"mdx:h2","props":{"id":"release-scope"},"children":["Release scope"]},"\n",{"tag":"p","props":{},"children":[["This page describes ",{"tag":"code","props":{},"children":["@jfdevelops/react-layout@0.25.0"]},". Earlier 0.x releases can differ. The behavior is based on the error definitions and their call sites in ",{"tag":"mdx:a","props":{"href":"https://github.com/jfdevelops/react-layout/blob/%40jfdevelops%2Freact-layout%400.25.0/packages/core/src/create-config/render-state.ts"},"children":["the tagged source"]},"."]]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../final-snapshot.md"},"children":["Final snapshot"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../standard-schema.md"},"children":["Standard Schema"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../reference/api.md"},"children":["API reference"]}]},"\n"]]}],"toc":[{"title":"Identify the error","url":"#identify-the-error","depth":2},{"title":"Resolve the error","url":"#resolve-the-error","depth":2},{"title":"Release scope","url":"#release-scope","depth":2},{"title":"Next steps","url":"#nex