{"schemaVersion":1,"framework":"react","version":"v0","id":"index","title":"Overview","description":"The unstable 0.x line. Read this before using any 0.x release.","body":[{"tag":"p","props":{},"children":[[{"tag":"code","props":{},"children":["@jfdevelops/react-layout"]}," was published as ",{"tag":"code","props":{},"children":["0.x"]}," from ",{"tag":"code","props":{},"children":["0.1.1"]}," to ",{"tag":"code","props":{},"children":["0.25.0"]},". This section is a ",{"tag":"strong","props":{},"children":["legacy snapshot"]},", not a version-by-version manual."]]},"\n",{"tag":"mdx:blockquote","props":{},"children":[["\n",{"tag":"p","props":{},"children":[[{"tag":"strong","props":{},"children":["Warning:"]}," Do not treat ",{"tag":"code","props":{},"children":["0.x"]}," as stable. Under semver, any ",{"tag":"code","props":{},"children":["0.x"]}," minor may break. This project used that freedom often. The docs here describe one release, ",{"tag":"code","props":{},"children":["0.25.0"]},", and do not promise accuracy for any other ",{"tag":"code","props":{},"children":["0.x"]}," version."]]},"\n"]]},"\n",{"tag":"mdx:h2","props":{"id":"what-this-section-covers"},"children":["What this section covers"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[["\n",{"tag":"p","props":{},"children":[[{"tag":"mdx:a","props":{"href":"./standard-schema.md"},"children":["Standard Schema"]},": schema integration and validation support."]]},"\n"]]},"\n",{"tag":"li","props":{},"children":[["\n",{"tag":"p","props":{},"children":[[{"tag":"mdx:a","props":{"href":"./errors/layout-configuration.md"},"children":["Runtime errors"]},": configuration failures and how to resolve them; the Errors section lists every error for this release."]]},"\n"]]},"\n",{"tag":"li","props":{},"children":[["\n",{"tag":"p","props":{},"children":[[{"tag":"mdx:a","props":{"href":"./final-snapshot.md"},"children":["The final snapshot"]},": how ",{"tag":"code","props":{},"children":["0.25.0"]}," is used, from its own README and changelog."]]},"\n"]]},"\n",{"tag":"li","props":{},"children":[["\n",{"tag":"p","props":{},"children":[[{"tag":"mdx:a","props":{"href":"./reference/api.md"},"children":["API reference for 0.25.0"]},": its runtime exports, classified."]]},"\n"]]},"\n"]]},"\n",{"tag":"p","props":{},"children":[["It does ",{"tag":"strong","props":{},"children":["not"]}," cover each ",{"tag":"code","props":{},"children":["0.x"]}," minor. There are 42 published ",{"tag":"code","props":{},"children":["0.x"]}," versions, and no page is promised for the others. For a specific version, read that tag's source and ",{"tag":"code","props":{},"children":["packages/core/CHANGELOG.md"]}," in the repository."]]},"\n",{"tag":"mdx:h2","props":{"id":"why-0x-changed-so-much"},"children":["Why 0.x changed so much"]},"\n",{"tag":"p","props":{},"children":["The package changed shape quickly between 2026-06-02 and 2026-10-21. Examples recorded in the core changelog:"]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Release"]},{"tag":"th","props":{},"children":["Change"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["0.4.0"]}]},{"tag":"td","props":{},"children":["Validators, composables and the breadcrumb preset were split into separate packages."]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["0.13.0"]}]},{"tag":"td","props":{},"children":[["Per-resource entries moved under a ",{"tag":"code","props":{},"children":["resources"]}," key. An explicit type argument on scoped components was dropped."]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["0.18.0"]}]},{"tag":"td","props":{},"children":[["The ",{"tag":"code","props":{},"children":["subResources"]}," wrapper in resource configs was removed. Nested ",{"tag":"code","props":{},"children":["subResource"]}," params became ",{"tag":"code","props":{},"children":["{ value, subResource }"]},". A typed error hierarchy was added."]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["0.19.0"]}]},{"tag":"td","props":{},"children":[[{"tag":"code","props":{},"children":["resources.current"]}," replaced the render context's ",{"tag":"code","props":{},"children":["resource"]},", which was deprecated."]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["0.20.0"]}]},{"tag":"td","props":{},"children":[[{"tag":"code","props":{},"children":["resources.pick"]}," and ",{"tag":"code","props":{},"children":["resources.omit"]}," began to require at least one key and return a selection thunk."]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["0.22.0"]}]},{"tag":"td","props":{},"children":["Grouped resource-link ids became deterministic instead of random."]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["0.25.0"]}]},{"tag":"td","props":{},"children":["Render states and lazy loading were added."]}]]}]]}]]},"\n",{"tag":"p","props":{},"children":[[{"tag":"code","props":{},"children":["1.0.0"]}," then replaced the chained ",{"tag":"code","props":{},"children":["createDefinedResourceLayout"]}," builder. See ",{"tag":"mdx:a","props":{"href":"../v1/migration.md"},"children":["Migrating from v0 to v1"]},"."]]},"\n",{"tag":"mdx:h2","props":{"id":"which-package-versions-go-with-0250"},"children":["Which package versions go with 0.25.0"]},"\n",{"tag":"p","props":{},"children":[["At the ",{"tag":"code","props":{},"children":["0.25.0"]}," tag (commit ",{"tag":"code","props":{},"children":["185598a15d362035ac59a5429404642d9c52abb4"]},"), the repository's ",{"tag":"code","props":{},"children":["packages/*/package.json"]}," carried these versions. npm resolved core's published ",{"tag":"code","props":{},"children":["dependencies"]}," to the same set."]]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Package"]},{"tag":"th","props":{},"children":["Version"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["@jfdevelops/react-layout"]}]},{"tag":"td","props":{},"children":["0.25.0"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[[{"tag":"code","props":{},"children":["@jfdevelops/react-layout-composables"]}," (internal dependency)"]]},{"tag":"td","props":{},"children":["0.2.8"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[[{"tag":"code","props":{},"children":["@jfdevelops/react-layout-validator"]}," (internal dependency)"]]},{"tag":"td","props":{},"children":["0.3.0"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["@jfdevelops/react-layout-composable-breadcrumb"]}]},{"tag":"td","props":{},"children":["0.2.8"]}]]}]]}]]},"\n",{"tag":"p","props":{},"children":[["Core also depended on ",{"tag":"code","props":{},"children":["@jfdevelops/create-error"]}," 0.2.0 and ",{"tag":"code","props":{},"children":["arktype"]}," 2.2.8. The inspector, the Vite plugin and the schema adapters did not exist yet."]]},"\n",{"tag":"mdx:h2","props":{"id":"moving-off-v0"},"children":["Moving off v0"]},"\n",{"tag":"p","props":{},"children":[["Upgrade to ",{"tag":"mdx:a","props":{"href":"../v1/index.md"},"children":["v1"]}," and then onward one major at a time. Each version's migration page lists the changes between adjacent majors."]]}],"toc":[{"title":"What this section covers","url":"#what-this-section-covers","depth":2},{"title":"Why 0.x changed so much","url":"#why-0x-changed-so-much","depth":2},{"title":"Which package versions go with 0.25.0","url":"#which-package-versions-go-with-0250","depth":2},{"title":"Moving off v0","url":"#moving-off-v0","depth":2}]}