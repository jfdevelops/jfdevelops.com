{"schemaVersion":1,"framework":"react","version":"v3","id":"errors/invalid-schema-path","title":"InvalidSchemaPathError","description":"When InvalidSchemaPathError occurs and how to resolve it.","body":[{"tag":"p","props":{},"children":["getSchemaAtPath cannot resolve a path segment to a schema. The segment is unknown, or the current schema is opaque to the built-in schema traversal."]},"\n",{"tag":"mdx:h2","props":{"id":"identify-the-error"},"children":["Identify the error"]},"\n",{"tag":"p","props":{},"children":[["The error code is ",{"tag":"code","props":{},"children":["invalidSchemaPath"]},". This error belongs to the validator package and is not part of the ",{"tag":"code","props":{},"children":["ReactLayoutError"]}," hierarchy."]]},"\n",{"tag":"mdx:h2","props":{"id":"resolve-the-error"},"children":["Resolve the error"]},"\n",{"tag":"p","props":{},"children":["Inspect context.path, context.segment and context.reason. Use a supported built-in schema structure and a path it declares."]},"\n",{"tag":"mdx:h2","props":{"id":"release-scope"},"children":["Release scope"]},"\n",{"tag":"p","props":{},"children":[["This page describes ",{"tag":"code","props":{},"children":["@jfdevelops/react-layout@3.3.0"]},". The behavior is based on the error definitions and their call sites in ",{"tag":"mdx:a","props":{"href":"https://github.com/jfdevelops/react-layout/blob/%40jfdevelops%2Freact-layout%403.3.0/packages/validators/src/schema-path.ts"},"children":["the tagged source"]},"."]]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../troubleshooting.md"},"children":["Troubleshooting"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../standard-schema.md"},"children":["Standard Schema"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../reference/api.md"},"children":["API reference"]}]}