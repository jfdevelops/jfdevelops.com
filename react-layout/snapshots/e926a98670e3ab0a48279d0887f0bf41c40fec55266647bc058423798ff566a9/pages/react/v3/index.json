{"schemaVersion":1,"framework":"react","version":"v3","id":"index","title":"Overview","description":"What the library includes, what changed from the previous major, and where to start.","body":[{"tag":"p","props":{},"children":["React Layout is a React library for resource-based page layouts. You define the\nshared structure of your pages once, then create a typed component for each\nresource."]},"\n",{"tag":"mdx:blockquote","props":{},"children":[["\n",{"tag":"p","props":{},"children":[[{"tag":"strong","props":{},"children":["Note:"]}," The examples in this section are adapted from the package's own documentation\nand tests for its last release. They were not compiled. The repository does not promise\nfixes to this major."]]},"\n"]]},"\n",{"tag":"mdx:h2","props":{"id":"core-ideas"},"children":["Core ideas"]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Term"]},{"tag":"th","props":{},"children":["Meaning"]},{"tag":"th","props":{},"children":["Example"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Resource"]},{"tag":"td","props":{},"children":["A page or section of your app, named by a string."]},{"tag":"td","props":{},"children":[[{"tag":"code","props":{},"children":["users"]},", ",{"tag":"code","props":{},"children":["users.detail"]}]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Option"]},{"tag":"td","props":{},"children":["A typed value a page supplies when it is created."]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["title: 'Users'"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Layout"]},{"tag":"td","props":{},"children":["The shared render function that turns options into markup."]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["layout.render"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Composable"]},{"tag":"td","props":{},"children":["A named slot component that keeps shared markup consistent."]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["composables.Title"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Render state"]},{"tag":"td","props":{},"children":[["A variant of a page such as ",{"tag":"code","props":{},"children":["Loading"]}," or ",{"tag":"code","props":{},"children":["Error"]},"."]]},{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["<Users.Loading />"]}]}]]}]]}]]},"\n",{"tag":"mdx:h2","props":{"id":"what-changed"},"children":["What changed"]},"\n",{"tag":"p","props":{},"children":["v3.0.0 was a coordinated major release of every package. Compared with v2:"]},"\n",{"tag":"ol","props":{},"children":[["\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":["Props use Standard Schema only."]}," ",{"tag":"code","props":{},"children":["createProp"]}," and the legacy prop builders\nwere removed. Use Zod, Valibot, ArkType, Effect or any Standard Schema library,\nplus the React adapters."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":[["React components get optional ",{"tag":"code","props":{},"children":["children"]}," by default"]]},", including the prop\nschemas retained for reuse."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":["Public generic types are cheaper to check"]},", and most large builder types now\ndeclare invariant parameters."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":[["A private ",{"tag":"code","props":{},"children":["@jfdevelops/react-layout-internals"]}," package"]]}," holds shared types.\nDo not import it."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"strong","props":{},"children":["Smaller API cleanups:"]}," ",{"tag":"code","props":{},"childr