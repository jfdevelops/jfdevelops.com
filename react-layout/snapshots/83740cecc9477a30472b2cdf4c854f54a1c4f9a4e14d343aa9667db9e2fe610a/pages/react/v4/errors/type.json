{"schemaVersion":1,"framework":"react","version":"v4","id":"errors/type","title":"TypeError","description":"When TypeError occurs and how to resolve it.","body":[{"tag":"p","props":{},"children":["A runtime argument or schema violates a contract that is checked with a native TypeError."]},"\n",{"tag":"mdx:h2","props":{"id":"identify-the-error"},"children":["Identify the error"]},"\n",{"tag":"p","props":{},"children":["This is a native JavaScript error."]},"\n",{"tag":"mdx:h2","props":{"id":"checked-contracts"},"children":["Checked contracts"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":["An options object schema must produce a non-null object, not an array."]},"\n",{"tag":"li","props":{},"children":["Standard Schema validation must complete synchronously; promise results are rejected."]},"\n",{"tag":"li","props":{},"children":["Custom path parameter names must not conflict with reserved or included names."]},"\n",{"tag":"li","props":{},"children":["Renderer factory options, props and params must be objects."]},"\n",{"tag":"li","props":{},"children":[["The renderer factory ",{"tag":"code","props":{},"children":["component"]}," value must be a string component key or ",{"tag":"code","props":{},"children":["\"*\""]},", and requires included component keys."]]},"\n",{"tag":"li","props":{},"children":[["A renderer factory component key belongs in ",{"tag":"code","props":{},"children":["component"]},", not ",{"tag":"code","props":{},"children":["params.componentKey"]},"."]]},"\n"]]},"\n",{"tag":"p","props":{},"children":[["A synchronous union also rejects an asynchronous member schema with a ",{"tag":"code","props":{},"children":["TypeError"]},"."]]},"\n",{"tag":"mdx:h2","props":{"id":"resolve-the-error"},"children":["Resolve the error"]},"\n",{"tag":"p","props":{},"children":["Correct the input identified by the message. These errors are not ReactLayoutError instances."]},"\n",{"tag":"mdx:h2","props":{"id":"release-scope"},"children":["Release scope"]},"\n",{"tag":"p","props":{},"children":[["This page describes ",{"tag":"code","props":{},"children":["@jfdevelops/react-layout@4.1.0"]},". The behavior is based on the error definitions and their call sites in ",{"tag":"mdx:a","props":{"href":"https://github.com/jfdevelops/react-layout/tree/%40jfdevelops%2Freact-layout%404.1.0/packages/core/src"},"children":["the tagged source"]},"."]]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../guides/troubleshooting.md"},"children":["Troubleshooting"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../standard-schema.md"},"children":["Standard Schema"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../reference/index.md"},"children":["API reference"]}]},"\n"]]}],"toc":[{"title":"Identify the error","url":"#identify-the-error","depth":2},{"title":"Checked contracts","url":"#checked-contracts","depth":2},{"title":"Resolve the error","url":"#resolve-the-error","depth":2},{"title":"Release scope","url":"#release-scope","depth":2},{"title":"Next steps","url":"#next-steps","depth":2}]}