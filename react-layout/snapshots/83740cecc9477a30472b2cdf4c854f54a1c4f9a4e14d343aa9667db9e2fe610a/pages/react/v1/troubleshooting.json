{"schemaVersion":1,"framework":"react","version":"v1","id":"troubleshooting","title":"Troubleshooting","description":"Common errors and type errors, what causes each, and how to fix it.","body":[{"tag":"p","props":{},"children":["Each entry gives the symptom, the cause and the fix. Find the heading that matches what you\nsee."]},"\n",{"tag":"mdx:h2","props":{"id":"definitions-and-naming"},"children":["Definitions and naming"]},"\n",{"tag":"mdx:h3","props":{"id":"resource-is-a-type-error-or-a-lookup-throws-invalidresourceerror"},"children":[[{"tag":"code","props":{},"children":["resource"]}," is a type error, or a lookup throws ",{"tag":"code","props":{},"children":["InvalidResourceError"]}]]},"\n",{"tag":"p","props":{},"children":[["The resource is not in the ",{"tag":"code","props":{},"children":["resources"]}," list. Add it to the definition, or fix the spelling.\nSub-resources use dot paths such as ",{"tag":"code","props":{},"children":["users.managers"]},". A path that does not exist throws\n",{"tag":"code","props":{},"children":["InvalidPathError"]},", and a missing variable such as ",{"tag":"code","props":{},"children":["$resource"]}," throws\n",{"tag":"code","props":{},"children":["MissingPathVariableError"]},"."]]},"\n",{"tag":"mdx:h3","props":{"id":"useresource-throws-missingresourceprovidererror"},"children":[[{"tag":"code","props":{},"children":["useResource"]}," throws ",{"tag":"code","props":{},"children":["MissingResourceProviderError"]}]]},"\n",{"tag":"p","props":{},"children":[["The component is not rendered inside a page created by that definition. Render it under a\ncreated page, or wrap it in the definition's ",{"tag":"code","props":{},"children":["ResourceProvider"]},"."]]},"\n",{"tag":"mdx:h3","props":{"id":"invalidparterror-or-invalidparttypeerror-from-a-naming-convention"},"children":[[{"tag":"code","props":{},"children":["InvalidPartError"]}," or ",{"tag":"code","props":{},"children":["InvalidPartTypeError"]}," from a naming convention"]]},"\n",{"tag":"p","props":{},"children":[["A naming part has an undeclared key or the wrong kind of value. Declare the part with\n",{"tag":"code","props":{},"children":["defineLayoutName.defineParts(...)"]},", pass a value of the declared kind, or set ",{"tag":"code","props":{},"children":["strict: false"]},"."]]},"\n",{"tag":"mdx:h3","props":{"id":"definelayoutname-or-namingfn-rejects-my-argument"},"children":[[{"tag":"code","props":{},"children":["defineLayoutName"]}," or ",{"tag":"code","props":{},"children":["namingFn"]}," rejects my argument"]]},"\n",{"tag":"p","props":{},"children":[["Since 1.6.1 both require a single configuration object with a ",{"tag":"code","props":{},"children":["pattern"]}," and an optional\n",{"tag":"code","props":{},"children":["strict"]},". The callback-only shorthand was removed."]]},"\n",{"tag":"mdx:h3","props":{"id":"a-scoped-component-name-is-rejected"},"children":["A scoped component name is rejected"]},"\n",{"tag":"p","props":{},"children":[["Names such as ",{"tag":"code","props":{},"children":["makeComposable"]},", ",{"tag":"code","props":{},"children":["name"]}," or ",{"tag":"code","props":{},"children":["call"]}," collide with reserved members. A resource\nwhose capitalized name is ",{"tag":"code","props":{},"children":["Root"]}," is also rejected. Rename the resource or component."]]},"\n",{"tag":"mdx:h2","props":{"id":"props"},"children":["Props"]},"\n",{"tag":"mdx:h3","props":{"id":"a-prop-fails-validation"},"children":["A prop fails validation"]},"\n",{"tag":"p","props":{},"children":[["A failed prop throws a ",{"tag":"code","props":{},"children":["PropError"]}," with the prop path, layout name and resource. Supply the\nvalue, or make the definition ",{"tag":"code","props":{},"children":[".optional()"]},"."]]},"\n",{"tag":"mdx:h3","props":{"id":"visibility-or-passthrough-still-compile"},"children":[[{"tag":"code","props":{},"children":["visibility"]}," or ",{"tag":"code","props":{},"children":["passthrough"]}," still compile"]]},"\n",{"tag":"p","props":{},"children":[["They are deprecated aliases in v1. Prefer ",{"tag":"code","props":{},"children":["required"]}," and ",{"tag":"code","props":{},"children":["suppliedVia"]},". Both are removed in\n2.0.0 and produce a configuration error there."]]},"\n",{"tag":"mdx:h3","props":{"id":"createproparray-is-missing"},"children":[[{"tag":"code","props":{},"children":["createProp.array"]}," is missing"]]},"\n",{"tag":"p","props":{},"children":[["It does not exist in v1. Describe the value with ",{"tag":"code","props":{},"children":["createProp.object"]}," or ",{"tag":"code","props":{},"children":["createProp.record"]},",\nor use a ",{"tag":"code","props":{},"children":["createProp.component({ type: 'ReactNode' })"]}," for rendered content."]]},"\n",{"tag":"mdx:h2","props":{"id":"lazy-loading"},"children":["Lazy loading"]},"\n",{"tag":"mdx:h3","props":{"id":"a-lazy-module-throws-about-its-exports"},"children":["A lazy module throws about its exports"]},"\n",{"tag":"p","props":{},"children":[["A lazy module must export exactly one component (or one state, for\n",{"tag":"code","props":{},"children":["createRenderState.lazy"]},") created by the library."]]},"\n",{"tag":"mdx:h3","props":{"id":"a-lazy-error-shows-for-a-render-exception"},"children":[["A lazy ",{"tag":"code","props":{},"children":["Error"]}," shows for a render exception"]]},"\n",{"tag":"p","props":{},"children":[["That is v1 behavior. In v2 and later it handles only lazy failures. See\n",{"tag":"mdx:a","props":{"href":"../v2/migration.md"},"children":["Migrating to v2"]},"."]]},"\n",{"tag":"mdx:h2","props":{"id":"devtools"},"children":["Devtools"]},"\n",{"tag":"mdx:h3","props":{"id":"the-inspector-is-empty"},"children":["The inspector is empty"]},"\n",{"tag":"p","props":{},"children":[["Pass the ",{"tag":"strong","props":{},"children":["full factory result"]}," as ",{"tag":"code","props":{},"children":["source"]},", not one created component. Modules that were\nnever imported cannot contribute definitions."]]},"\n",{"tag":"mdx:h3","props":{"id":"the-inspector-renders-nothing"},"children":["The inspector renders nothing"]},"\n",{"tag":"p","props":{},"children":[["The default import is empty when ",{"tag":"code","props":{},"children":["process.env.NODE_ENV"]}," is ",{"tag":"code","props":{},"children":["production"]},". Use the ",{"tag":"code","props":{},"children":["/production"]},"\nentry, or ",{"tag":"code","props":{},"children":["reactLayoutDevtools({ production: true })"]}," with the Vite plugin, to keep it on\npurpose."]]},"\n",{"tag":"mdx:h3","props":{"id":"source-links-or-state-previews-are-missing"},"children":["Source links or state previews are missing"]},"\n",{"tag":"p","props":{},"children":[["They need ",{"tag":"code","props":{},"children":["@jfdevelops/react-layout-devtools-vite"]}," in a development Vite build."]]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"./reference/api.md"},"children":["API reference"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"./migration.md"},"children":["Migration from v0"]}]},"\n"]]}],"toc":[{"title":"Definitions and naming","url":"#definitions-and-naming","depth":2},{"title":"resource is a type error, or a lookup throws InvalidResourceError","url":"#resource-is-a-type-error-or-a-lookup-throws-invalidresourceerror","depth":3},{"title":"useResource throws MissingResourceProviderError","url":"#useresource-throws-missingresourceprovidererror","depth":3},{"title":"InvalidPartError or InvalidPartTypeError from a naming convention","url":"#invalidparterror-or-invalidparttypeerror-from-a-naming-convention","depth":3},{"title":"defineLayoutName or namingFn rejects my argument","url":"#definelayoutname-or-namingfn-rejects-my-argument","depth":3},{"title":"A scoped component name is rejected","url":"#a-scoped-component-name-is-rejected","depth":3},{"title":"Props","url":"#props","depth":2},{"title":"A prop fails validation","url":"#a-prop-fails-validation","depth":3},{"title":"visibility or passthrough still compile","url":"#visibility-or-passthrough-still-compile","depth":3},{"title":"createProp.array is missing","url":"#createproparray-is-missing","depth":3},{"title":"Lazy loading","url":"#lazy-loading","depth":2},{"title":"A lazy module throws about its exports","url":"#a-lazy-module-throws-about-its-exports","depth":3},{"title":"A lazy Error shows for a render exception","url":"#a-lazy-error-shows-for-a-render-exception","depth":3},{"title":"Devtools","url":"#devtools","depth":2},{"title":"The inspector is empty","url":"#the-inspector-is-empty","depth":3},{"title":"The inspector renders nothing","url":"#the-inspector-renders-nothing","depth":3},{"title":"Source links or state previews are missing","url":"#source-links-or-state-previews-are-missing","depth":3},{"title":"Next steps","url":"#next-steps","depth":2}]}