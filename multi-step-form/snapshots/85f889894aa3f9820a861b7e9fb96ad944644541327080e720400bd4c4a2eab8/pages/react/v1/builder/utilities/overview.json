{"schemaVersion":1,"framework":"react","version":"v1","id":"builder/utilities/overview","title":"Builder utilities","description":"Find the lower-level helpers for schema tooling, editor models, validation, and source emission.","body":[{"tag":"p","props":{},"children":["Builder utilities let you implement custom editor surfaces and validator adapters\nwithout reproducing the definition, schema, and code-generation rules."]},"\n",{"tag":"mdx:h2","props":{"id":"choose-a-utility-workflow"},"children":["Choose a utility workflow"]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Need"]},{"tag":"th","props":{},"children":["Guide"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Create IDs and keys, inspect registry defaults, or import existing steps"]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"definition-utilities.md"},"children":["Definition utilities"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Traverse schemas, fit defaults, serialize dates, or display types"]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"schema-values.md"},"children":["Schema and value utilities"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Build a custom canvas, inspector, or property editor"]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"editor-models.md"},"children":["Editor models and actions"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Resolve validation and compile one step"]},{"tag":"td","props":{},"children":[{"tag":"mdx:a","props":{"href":"validator-utilities.md"},"children":["Validator utilities"]}]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Add a validator library"]},{"tag":"td","props":{},"children":[{"tag":"m