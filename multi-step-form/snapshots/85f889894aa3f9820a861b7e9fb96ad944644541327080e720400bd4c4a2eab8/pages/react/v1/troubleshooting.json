{"schemaVersion":1,"framework":"react","version":"v1","id":"troubleshooting","title":"Troubleshooting","description":"Diagnose stale renders, unexpected instance behavior, missing defaults, and incomplete navigation gates.","body":[{"tag":"p","props":{},"children":["Most integration problems come from reading a different instance than the one\nbeing updated, bypassing subscriptions, or expecting the runtime to own an\napplication decision such as routing."]},"\n",{"tag":"mdx:h2","props":{"id":"find-the-symptom"},"children":["Find the symptom"]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Symptom"]},{"tag":"th","props":{},"children":["Check"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Answer changes but summary stays stale"]},{"tag":"td","props":{},"children":["Use a selector or bound hook for rendered data"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Field type is unexpectedly narrow"]},{"tag":"td","props":{},"children":["Type empty arrays and union defaults intentionally"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Update fails shape validation"]},{"tag":"td","props":{},"children":["Check the selected path and the returned value's shape"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Two screens share answers"]},{"tag":"td","props":{},"children":["Check factory lifetime and instance names"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Separate instances overwrite saved drafts"]},{"tag":"td","props":{},"children":["Give them separate storage keys"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Shared helper updates the wrong form"]},{"tag":"td","props":{},"children":["Check the active instance or use a bound operation"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["NoActiveInstanceError"]}]},{"tag":"td","props":{},"children":["Create or select an instance before calling a factory helper"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Continue allows an empty step"]},{"tag":"td","props":{},"children":[["Define ",{"tag":"code","props":{},"children":["isComplete"]}," and enforce it in navigation"]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Async step has no fields"]},{"tag":"td","props":{},"children":[["Resolve it or render through the step's ",{"tag":"code","props":{},"children":["Suspend"]}," utility"]]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":["Native form is missing"]},{"tag":"td","props":{},"children":[["Import the React definition and configure ",{"tag":"code","props":{},"children":["formLibrary"]}]]}]]}]]}]]},"\n",{"tag":"mdx:h2","props":{"id":"trace-one-answer"},"children":["Trace one answer"]},"\n",{"tag":"ol","props":{},"children":[["\n",{"tag":"li","props":{},"children":["Identify the final schema returned by your configuration chain."]},"\n",{"tag":"li","props":{},"children":["Check that the field component is bound to that schema."]},"\n",{"tag":"li","props":{},"children":[["Read its current ",{"tag":"code","props":{},"children":["fields.<name>.defaultValue"]}," in the event handler."]]},"\n",{"tag":"li","props":{},"children":["Check that visible consumers subscribe to the same schema."]},"\n",{"tag":"li","props":{},"children":["Inspect the storage key separately if the issue appears only after reload."]},"\n"]]},"\n",{"tag":"p","props":{},"children":[["Do not mutate ",{"tag":"code","props":{},"children":["stepSchema.value"]}," directly. Use ",{"tag":"code","props":{},"children":["onInputChange"]},", ",{"tag":"code","props":{},"children":["update"]},", or a\nreusable operation so change notifications and persistence run."]]},"\n",{"tag":"mdx:h2","props":{"id":"preserve-the-configured-schema"},"children":["Preserve the configured schema"]},"\n",{"tag":"p","props":{},"children":[[{"tag":"code","props":{},"children":["withOverrides"]},", ",{"tag":"code","props":{},"children":["withForm"]},", and ",{"tag":"code","props":{},"children":["withContext"]}," return new schemas. Use the returned\nobject and finish the chain before creating components. Do not repeatedly build\nthe chain while rendering or keep writing through the superseded object."]]},"\n",{"tag":"p","props":{},"children":[["Context hooks created by ",{"tag":"code","props":{},"children":["withContext()"]}," are bound to the schema. Factory shared\nhelpers instead use the active instance. These are different selection mechanisms;\nmounting a subtree does not automatically select the active factory instance."]]},"\n",{"tag":"mdx:h2","props":{"id":"diagnose-async-failures"},"children":["Diagnose async failures"]},"\n",{"tag":"p","props":{},"children":[["Read ",{"tag":"code","props":{},"children":["getStepStatus"]}," and ",{"tag":"code","props":{},"children":["getStepError"]}," before assuming loaded fields exist.\nCatch ",{"tag":"code","props":{},"children":["resolveStep"]}," failures and retry by resolving again. Definitions cache per\ninstance; reset restores their defaults and does not refetch live server data."]]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../../core/v1/guides/instances-and-storage.md"},"children":["Instances and lifetime"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"guides/subscriptions.md"},"children":["Subscriptions"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../../core/v1/guides/async-data.md"},"children":["Async definitions and defaults"]}]},"\n",{"tag":"li","props":{},"children":[{"tag":"mdx:a","props":{"href":"../../core/v1/guides/updates-and-helpers.md"},"children":["Typed updates"]}]},"\n"]]}],"toc":[{"title":"Find the symptom","url":"#find-the-symptom","depth":2},{"title":"Trace one answer","url":"#trace-one-answer","depth":2},{"title":"Preserve the configured schema","url":"#preserve-the-configured-schema","depth":2},{"title":"Diagnose async failures","url":"#diagnose-async-failures","depth":2},{"title":"Next steps","url":"#next-steps","depth":2}]}