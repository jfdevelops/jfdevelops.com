{"schemaVersion":1,"framework":"agnostic","version":"v0","id":"package-discovery","title":"Package discovery","description":"Read and validate the package metadata that declares bundled agent skills.","body":[{"tag":"p","props":{},"children":[["The ",{"tag":"code","props":{},"children":["jfdevelops.skills"]}," field in ",{"tag":"code","props":{},"children":["package.json"]}," declares the skills shipped by a package. Tooling can use it to discover instruction directories in an installed package version."]]},"\n",{"tag":"mdx:h2","props":{"id":"read-the-declaration"},"children":["Read the declaration"]},"\n",{"tag":"mdx:pre","props":{"className":"shiki shiki-themes github-light github-dark","style":{"--shiki-light":"#24292e","--shiki-dark":"#e1e4e8","--shiki-light-bg":"#fff","--shiki-dark-bg":"#24292e"},"tabIndex":"0","icon":"<svg viewBox=\"0 0 24 24\"><path d=\"M 6,1 C 4.354992,1 3,2.354992 3,4 v 16 c 0,1.645008 1.354992,3 3,3 h 12 c 1.645008,0 3,-1.354992 3,-3 V 8 7 A 1.0001,1.0001 0 0 0 20.707031,6.2929687 l -5,-5 A 1.0001,1.0001 0 0 0 15,1 h -1 z m 0,2 h 7 v 3 c 0,1.645008 1.354992,3 3,3 h 3 v 11 c 0,0.564129 -0.435871,1 -1,1 H 6 C 5.4358712,21 5,20.564129 5,20 V 4 C 5,3.4358712 5.4358712,3 6,3 Z M 15,3.4140625 18.585937,7 H 16 C 15.435871,7 15,6.5641288 15,6 Z\" fill=\"currentColor\" /></svg>"},"children":[{"tag":"code","props":{},"children":[[{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},"children":["{"]}]},"\n",{"tag":"span","props":{"className":"line"},"children":[[{"tag":"span","props":{"style":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"}},"children":["  \"jfdevelops\""]},{"tag":"span","props":{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},"children":[": {"]}]]},"\n",{"tag":"span","props":{"className":"line"},"children":[[{"tag":"span","props":{"style":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"}},"children":["    \"skills\""]},{"tag":"span","props":{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},"children":[": ["]}]]},"\n",{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},"children":["      {"]}]},"\n",{"tag":"span","props":{"className":"line"},"children":[[{"tag":"span","props":{"style":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"}},"children":["        \"name\""]},{"tag":"span","props":{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},"children":[": "]},{"tag":"span","props":{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"}},"children":["\"jf-naming-conventions\""]},{"tag":"span","props":{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},"children":[","]}]]},"\n",{"tag":"span","props":{"className":"line"},"children":[[{"tag":"span","props":{"style":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"}},"children":["        \"path\""]},{"tag":"span","props":{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},"children":[": "]},{"tag":"span","props":{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"}},"children":["\"./skills/jf-naming-conventions\""]}]]},"\n",{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},"children":["      }"]}]},"\n",{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},"children":["    ]"]}]},"\n",{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},"children":["  }"]}]},"\n",{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},"children":["}"]}]}]]}]},"\n",{"tag":"p","props":{},"children":["This is a jfdevelops convention, not an npm or Agent Skills standard. The fragment shows one entry; the package declares all nine bundled skills."]},"\n",{"tag":"mdx:table","props":{},"children":[[{"tag":"thead","props":{},"children":[{"tag":"tr","props":{},"children":[[{"tag":"th","props":{},"children":["Field"]},{"tag":"th","props":{},"children":["Requirement"]}]]}]},{"tag":"tbody","props":{},"children":[[{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["jfdevelops.skills"]}]},{"tag":"td","props":{},"children":["Nonempty array of skill declarations"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["name"]}]},{"tag":"td","props":{},"children":["Unique lowercase kebab-case name, at most 64 characters"]}]]},{"tag":"tr","props":{},"children":[[{"tag":"td","props":{},"children":[{"tag":"code","props":{},"children":["path"]}]},{"tag":"td","props":{},"children":[["Package-relative directory beginning with ",{"tag":"code","props":{},"children":["./"]},", containing ",{"tag":"code","props":{},"children":["SKILL.md"]}]]}]]}]]}]]},"\n",{"tag":"p","props":{},"children":[["The metadata object allows only ",{"tag":"code","props":{},"children":["skills"]},"; each declaration allows only ",{"tag":"code","props":{},"children":["name"]}," and ",{"tag":"code","props":{},"children":["path"]},". Names must match the directory name and the skill's frontmatter. Paths must stay inside the package, including after resolving symbolic links."]]},"\n",{"tag":"mdx:h2","props":{"id":"validate-the-contract"},"children":["Validate the contract"]},"\n",{"tag":"p","props":{},"children":[["The package exports the schema at ",{"tag":"code","props":{},"children":["@jfdevelops/skills/schemas/package-skills.schema.json"]},". It describes the ",{"tag":"code","props":{},"children":["jfdevelops"]}," object, rather than the entire package manifest."]]},"\n",{"tag":"p","props":{},"children":[["Schema validation checks structure and field syntax. Semantic validation must also check uniqueness, file existence, matching names, and resolved path containment. This repository's ",{"tag":"code","props":{},"children":["pnpm validate"]}," checks those conditions for its bundled skills; ",{"tag":"code","props":{},"children":["pnpm check"]}," additionally verifies package contents and installation."]]},"\n",{"tag":"mdx:h2","props":{"id":"separate-discovery-from-activation"},"children":["Separate discovery from activation"]},"\n",{"tag":"p","props":{},"children":[["The package has no JavaScript runtime entry point and runs no installer lifecycle hooks. Its exports expose ",{"tag":"code","props":{},"children":["package.json"]}," and the schema. Installing the npm package does not activate skills in an agent."]]},"\n",{"tag":"p","props":{},"children":[["Integration with the future jfdevelops CLI is a separate implementation step. Use the ",{"tag":"mdx:a","props":{"href":"installation.md"},"children":["documented installation workflow"]}," for agent setup today."]]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"overview.md"},"children":["Understand the bundled conventions"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"installation.md"},"children":["Install skills for an agent"]},"."]]},"\n"]]}],"toc":[{"title":"Read the declaration","url":"#read-the-declaration","depth":2},{"title":"Validate the contract","url":"#validate-the-contract","depth":2},{"title":"Separate discovery from activation","url":"#separate-discovery-from-activation","depth":2},{"title":"Next steps","url":"#next-steps","depth":2}]}