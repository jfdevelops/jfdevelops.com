iv","props":{"className":"twoslash shiki fd-codeblock prose-no-margin"},"children":[{"tag":"code","props":{"className":"twoslash-popup-code"},"children":[[{"tag":"span","props":{"style":{"--shiki-light":"#D73A49","--shiki-dark":"#F97583"}},"children":["const"]},{"tag":"span","props":{"style":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"}},"children":[" normalizedName"]},{"tag":"span","props":{"style":{"--shiki-light":"#D73A49","--shiki-dark":"#F97583"}},"children":[":"]},{"tag":"span","props":{"style":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"}},"children":[" string"]}]]}]}]},{"tag":"mdx:PopupTrigger","props":{},"children":["normalizedName"]}]]}]},{"tag":"span","props":{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},"children":[";"]}]]},"\n",{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{"style":{"--shiki-light":"#24292E","--shiki-dark":"#E1E4E8"}},"children":["}"]}]}]]}]},"\n",{"tag":"p","props":{},"children":["Formatter choices may control indentation, quotes, and semicolons, while retaining the required spacing policy. The skill describes a policy; automatic enforcement requires configured and verified formatter, lint, and project checks."]},"\n",{"tag":"mdx:h2","props":{"id":"types-and-organization"},"children":["Types and organization"]},"\n",{"tag":"p","props":{},"children":[["Return types are inferred unless a public contract, overload, assertion signature, recursion, or inference limitation requires annotation. Unknown input is validated and narrowed at boundaries. Type mismatches are fixed at their source rather than hidden with broad casts, ",{"tag":"code","props":{},"children":["any"]},", or disabled checks."]]},"\n",{"tag":"p","props":{},"children":[["Files contain one component, hook, or cohesive helper concern. Apps import from defining files; libraries may expose deliberate public entry points. Framework-independent logic stays separate from adapters. Route-private components and utilities stay beside their route in ",{"tag":"code","props":{},"children":["components/"]}," and ",{"tag":"code","props":{},"children":["utils/"]},", respecting the router's non-route directory convention."]]},"\n",{"tag":"mdx:h2","props":{"id":"react-and-verification"},"children":["React and verification"]},"\n",{"tag":"p","props":{},"children":[["React projects reuse existing UI primitives, keep presentation independent of data fetching, and place conditional class-name logic in the project's ",{"tag":"code","props":{},"children":["cn"]}," utility. Framework-specific guidance applies only when the project uses that framework."]]},"\n",{"tag":"p","props":{},"children":["Verification uses configured checks and meaningful regression coverage. Changes to library public types also require consumer compilation. Reports distinguish checks actually run from verification that could not be completed. The skill does not select optional dependencies or authorize commits, publication, or deployment."]},"\n",{"tag":"mdx:h2","props":{"id":"example-request"},"children":["Example request"]},"\n",{"tag":"mdx:pre","props":{"className":"shiki shiki-themes github-light github-dark","style":{"--shiki-light":"#24292e","--shiki-dark":"#e1e4e8","--shiki-light-bg":"#fff","--shiki-dark-bg":"#24292e"},"tabIndex":"0","icon":"<svg viewBox=\"0 0 24 24\"><path d=\"M 6,1 C 4.354992,1 3,2.354992 3,4 v 16 c 0,1.645008 1.354992,3 3,3 h 12 c 1.645008,0 3,-1.354992 3,-3 V 8 7 A 1.0001,1.0001 0 0 0 20.707031,6.2929687 l -5,-5 A 1.0001,1.0001 0 0 0 15,1 h -1 z m 0,2 h 7 v 3 c 0,1.645008 1.354992,3 3,3 h 3 v 11 c 0,0.564129 -0.435871,1 -1,1 H 6 C 5.4358712,21 5,20.564129 5,20 V 4 C 5,3.4358712 5.4358712,3 6,3 Z M 15,3.4140625 18.585937,7 H 16 C 15.435871,7 15,6.5641288 15,6 Z\" fill=\"currentColor\" /></svg>"},"children":[{"tag":"code","props":{},"children":[{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{},"children":["Implement the response parser using jf-coding-conventions. Validate unknown input at the boundary and run the project's relevant checks."]}]}]}]},"\n",{"tag":"p","props":{},"children":[["See ",{"tag":"mdx:a","props":{"href":"jf-naming-conventions.md"},"children":["jf-naming-conventions"]}," for naming and ",{"tag":"mdx:a","props":{"href":"jf-git.md"},"children":["jf-git"]}," for Git operations."]]}],"toc":[{"title":"Functions and spacing","url":"#functions-and-spacing","depth":2},{"title":"Types and organization","url":"#types-and-organization","depth":2},{"title":"React and verification","url":"#react-and-verification","depth":2},{"title":"Example request","url":"#example-request","depth":2}]}