yle":{"--shiki-light":"#005CC5","--shiki-dark":"#79B8FF"}},"children":["*"]},{"tag":"span","props":{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"}},"children":[".md"]},{"tag":"span","props":{"style":{"--shiki-light":"#032F62","--shiki-dark":"#9ECBFF"}},"children":[" .claude/agents/"]}]]}]]}]},"\n",{"tag":"p","props":{},"children":[["Commit them so everyone working on the project uses the same stages. To use them\nin every project instead, copy them to ",{"tag":"code","props":{},"children":["~/.claude/agents/"]},". Claude Code loads new\nagents when a session starts."]]},"\n",{"tag":"mdx:h2","props":{"id":"delegate-each-stage"},"children":["Delegate each stage"]},"\n",{"tag":"p","props":{},"children":[["Claude Code delegates to an agent when the task matches its description. To make\ndelegation reliable, add this to the project's ",{"tag":"code","props":{},"children":["CLAUDE.md"]},":"]]},"\n",{"tag":"mdx:pre","props":{"className":"shiki shiki-themes github-light github-dark","style":{"--shiki-light":"#24292e","--shiki-dark":"#e1e4e8","--shiki-light-bg":"#fff","--shiki-dark-bg":"#24292e"},"tabIndex":"0","icon":"<svg viewBox=\"0 0 24 24\"><path d=\"M 6,1 C 4.354992,1 3,2.354992 3,4 v 16 c 0,1.645008 1.354992,3 3,3 h 12 c 1.645008,0 3,-1.354992 3,-3 V 8 7 A 1.0001,1.0001 0 0 0 20.707031,6.2929687 l -5,-5 A 1.0001,1.0001 0 0 0 15,1 h -1 z m 0,2 h 7 v 3 c 0,1.645008 1.354992,3 3,3 h 3 v 11 c 0,0.564129 -0.435871,1 -1,1 H 6 C 5.4358712,21 5,20.564129 5,20 V 4 C 5,3.4358712 5.4358712,3 6,3 Z M 15,3.4140625 18.585937,7 H 16 C 15.435871,7 15,6.5641288 15,6 Z\" fill=\"currentColor\" /></svg>"},"children":[{"tag":"code","props":{},"children":[[{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{},"children":["## Documentation stages"]}]},"\n",{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{},"children":[null]}]},"\n",{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{},"children":["`jf-docs` stays in the main session. Run its stages in subagents:"]}]},"\n",{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{},"children":[null]}]},"\n",{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{},"children":["- `jf-docs-analyze` and `jf-docs-plan`: `docs-analyzer`."]}]},"\n",{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{},"children":["- `jf-docs-write`, including fixing confirmed review findings: `docs-writer`."]}]},"\n",{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{},"children":["- `jf-docs-review`: `docs-reviewer`."]}]},"\n",{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{},"children":[null]}]},"\n",{"tag":"span","props":{"className":"line"},"children":[{"tag":"span","props":{},"children":["Pass each stage the scope, the target version and the previous stage's output."]}]}]]}]},"\n",{"tag":"mdx:h2","props":{"id":"review-with-codex"},"children":["Review with Codex"]},"\n",{"tag":"p","props":{},"children":[[{"tag":"code","props":{},"children":["docs-reviewer"]}," runs the Codex CLI non-interactively with the ",{"tag":"code","props":{},"children":["jf-docs-review"]},"\nskill. Install the Codex CLI and sign in before using it. The agent sets the model,\nreasoning effort and a read-only sandbox on the command line, so Codex needs no\nextra configuration."]]},"\n",{"tag":"mdx:blockquote","props":{},"children":[["\n",{"tag":"p","props":{},"children":[[{"tag":"strong","props":{},"children":["Note:"]}," If Codex is missing, signed out, out of usage or times out, the agent\nreviews the docs with Claude instead. Its report always starts by naming which\nmodel reviewed."]]},"\n"]]},"\n",{"tag":"mdx:h2","props":{"id":"change-a-model"},"children":["Change a model"]},"\n",{"tag":"p","props":{},"children":[["Edit the ",{"tag":"code","props":{},"children":["model"]}," and ",{"tag":"code","props":{},"children":["effort"]}," frontmatter in the copied agent file. For the\nreviewer, change the ",{"tag":"code","props":{},"children":["-m"]}," and ",{"tag":"code","props":{},"children":["model_reasoning_effort"]}," values in its Codex command.\nRecopying the files after an update replaces these edits, so keep a note of them."]]},"\n",{"tag":"mdx:h2","props":{"id":"next-steps"},"children":["Next steps"]},"\n",{"tag":"ul","props":{},"children":[["\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"choose-skills.md"},"children":["Choose skills"]},"."]]},"\n",{"tag":"li","props":{},"children":[[{"tag":"mdx:a","props":{"href":"update-skills.md"},"children":["Update installed skills"]},"."]]},"\n"]]}],"toc":[{"title":"Choose the agents","url":"#choose-the-agents","depth":2},{"title":"Install the agents","url":"#install-the-agents","depth":2},{"title":"Delegate each stage","url":"#delegate-each-stage","depth":2},{"title":"Review with Codex","url":"#review-with-codex","depth":2},{"title":"Change a model","url":"#change-a-model","depth":2},{"title":"Next steps","url":"#next-steps","depth":2}]}